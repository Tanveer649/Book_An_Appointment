<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Book_An_Appointment1</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Configurations\**" />
    <Compile Remove="wwwroot\css\components\**" />
    <Compile Remove="wwwroot\css\themes\**" />
    <Compile Remove="wwwroot\js\components\**" />
    <Content Remove="Configurations\**" />
    <Content Remove="wwwroot\css\components\**" />
    <Content Remove="wwwroot\css\themes\**" />
    <Content Remove="wwwroot\js\components\**" />
    <EmbeddedResource Remove="Configurations\**" />
    <EmbeddedResource Remove="wwwroot\css\components\**" />
    <EmbeddedResource Remove="wwwroot\css\themes\**" />
    <EmbeddedResource Remove="wwwroot\js\components\**" />
    <None Remove="Configurations\**" />
    <None Remove="wwwroot\css\components\**" />
    <None Remove="wwwroot\css\themes\**" />
    <None Remove="wwwroot\js\components\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\Images\Logo\logo.png" />
  </ItemGroup>
	
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Appointment slip PDF. Keep 6.2.x: it is MIT. PDFsharp 6.5+ is AGPL-3.0 (would require publishing this
         portal's source code) — do NOT upgrade without checking the licence first. -->
    <PackageReference Include="PDFsharp" Version="[6.2.4]" />
    <!-- Appointment slip QR code (MIT) -->
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\Images\default-doctor.png" />
    <None Include="wwwroot\Images\Logo\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\css\pages\" />
  </ItemGroup>

</Project>

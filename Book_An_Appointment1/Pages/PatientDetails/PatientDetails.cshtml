@page "/patient-details"
@model Book_An_Appointment1.Pages.Appointment.PatientDetailsModel
@{
    ViewData["Title"] = L["PatientDetails.PageTitle"];

    // Links placed inside the translated consent sentence ({0} and {1})
    var termsLink = $"<a href=\"/terms\" target=\"_blank\" rel=\"noopener\">{System.Net.WebUtility.HtmlEncode(L.Text("PatientDetails.TermsConditions"))}</a>";
    var privacyLink = $"<a href=\"/privacy-policy\" target=\"_blank\" rel=\"noopener\">{System.Net.WebUtility.HtmlEncode(L.Text("PatientDetails.PrivacyPolicy"))}</a>";
}
@section Styles {
    <link rel="stylesheet" href="~/css/patient-details.css" asp-append-version="true" />
}
<div class="page">

    @* Server validation error modal *@
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="error-modal-overlay" id="serverErrorModal" role="alertdialog" aria-modal="true" aria-labelledby="serverErrorTitle">
            <div class="error-modal">
                <div class="error-modal-header">
                    <div class="error-modal-title" id="serverErrorTitle">⚠ @L["PatientDetails.FixIssues"]</div>
                    <button type="button" class="error-modal-close" aria-label="@L["Common.Close"]" onclick="closeServerErrorModal()">✕</button>
                </div>
                <div class="error-modal-body">
                    <ul class="error-list">
                        @foreach (var error in ViewData.ModelState.Values
                            .SelectMany(v => v.Errors)
                            .Select(e => e.ErrorMessage)
                            .Distinct())
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
                <div class="error-modal-footer">
                    <button type="button" class="error-modal-btn" onclick="closeServerErrorModal()">@L["PatientDetails.GotIt"]</button>
                </div>
            </div>
        </div>
    }

    @* Progress Bar *@
    <div class="progress-bar">
        <div class="step-item">
            <div class="step-circle done">✓</div>
            <span class="step-label done">@L["Steps.SelectSlot"]</span>
        </div>
        <div class="step-connector done"></div>
        <div class="step-item">
            <div class="step-circle active">2</div>
            <span class="step-label active">@L["Steps.PatientDetails"]</span>
        </div>
        <div class="step-connector"></div>
        <div class="step-item">
            <div class="step-circle pending">3</div>
            <span class="step-label">@L["Steps.ReviewConfirm"]</span>
        </div>
        <div class="step-connector"></div>
        <div class="step-item">
            <div class="step-circle pending">4</div>
            <span class="step-label">@L["Steps.Payment"]</span>
        </div>
    </div>

    <div class="page-layout">

        @* LEFT — Doctor Summary *@
        <div class="appt-sidebar">
            <div class="appt-summary">
                <div class="doc-avatar">@Model.Form.DoctorInitials</div>
                <div class="appt-info">
                    <strong>@Model.Form.DoctorName</strong>
                    <p>@Model.Form.Specialisation</p>
                    <p>@Model.Form.Hospital</p>
                </div>
                <div class="appt-divider"></div>
                <div class="appt-detail-row">
                    <div class="appt-detail-item">
                        <span class="detail-icon" aria-hidden="true">📅</span>
                        <div class="detail-text">
                            <span class="detail-label">@L["PatientDetails.Appointment"]</span>
                            <span class="detail-value">@Model.Form.SlotDisplayText</span>
                        </div>
                    </div>
                </div>
                @if (Model.Form.ConsultationFee > 0)
                {
                    <div class="fee-badge">₹ @Book_An_Appointment1.Helpers.Fee.Text(Model.Form.ConsultationFee)</div>
                }
            </div>
        </div>

        @* RIGHT — Form *@
        <div class="form-wrapper">
            <form method="post" id="patientForm" onsubmit="return validateForm()" novalidate>
                @Html.AntiForgeryToken()

                @* Common hidden fields *@
                <input type="hidden" asp-for="Form.PatientType" id="Form_PatientType" />
                <input type="hidden" id="Form_CountryId" name="Form.CountryId" value="@Model.Form.CountryId" />

                @* Patient Information Card *@
                <div class="section-card">
                    <div class="section-title"><span aria-hidden="true">👤</span> @L["PatientDetails.PatientInformation"]</div>

                    @* Shows the type chosen on page 1 — locked. It changes only via the "Continue as …" hint after the OTP API
                       reports the number as the other type (switchPatientType in patient-details.js) *@
                    <div class="patient-toggle" id="patientToggle" role="group" aria-label="@L["PatientDetails.PatientType"]">
                        <button type="button" class="toggle-btn active" id="btn-new" aria-pressed="true">
                            @L["Common.NewPatient"]
                        </button>
                        <button type="button" class="toggle-btn" id="btn-existing" aria-pressed="false" disabled>
                            @L["Common.AlreadyRegistered"]
                        </button>
                    </div>

                    @* ════════════════ NEW PATIENT FORM ════════════════ *@
                    <div id="new-patient-form">

                        <input type="hidden" asp-for="Form.NewPatient.Gender" id="Form_Gender" />
                        <input type="hidden" asp-for="Form.NewPatient.Mobile" id="Form_Mobile" />
                        <input type="hidden" asp-for="Form.NewPatient.IsMobileVerified" id="Form_IsMobileVerified" />
                        <input type="hidden" id="Form_StateId" name="Form.NewPatient.StateId" value="@Model.Form.NewPatient.StateId" />
                        <input type="hidden" id="Form_CityId" name="Form.NewPatient.CityId" value="@Model.Form.NewPatient.CityId" />
                        <input type="hidden" id="Form_StateName" name="Form.NewPatient.StateName" value="@Model.Form.NewPatient.StateName" />
                        <input type="hidden" id="Form_CityName" name="Form.NewPatient.CityName" value="@Model.Form.NewPatient.CityName" />
                        <input type="hidden" id="Form_CountryName" name="Form.CountryName" value="@Model.Form.CountryName" />

                        <div class="form-row form-row-4">
                            <div class="form-group">
                                <label for="Form_Title">@L["PatientDetails.Title"] <span class="required">*</span></label>
                                <select id="Form_Title" name="Form.NewPatient.TitleName">
                                    <option value="">--</option>
                                </select>
                                <input type="hidden" id="Form_TitleId" name="Form.NewPatient.TitleId" />
                            </div>
                            <div class="form-group">
                                <label for="Form_FirstName">@L["PatientDetails.FirstName"] <span class="required">*</span></label>
                                <input asp-for="Form.NewPatient.FirstName" id="Form_FirstName" type="text" placeholder="@L["PatientDetails.FirstName"]" autocomplete="given-name" />
                            </div>
                            <div class="form-group">
                                <label for="Form_MiddleName">@L["PatientDetails.MiddleName"]</label>
                                <input asp-for="Form.NewPatient.MiddleName" id="Form_MiddleName" type="text" placeholder="@L["PatientDetails.MiddleName"]" autocomplete="additional-name" />
                            </div>
                            <div class="form-group">
                                <label for="Form_LastName">@L["PatientDetails.LastName"] <span class="required">*</span></label>
                                <input asp-for="Form.NewPatient.LastName" id="Form_LastName" type="text" placeholder="@L["PatientDetails.LastName"]" autocomplete="family-name" />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="Form_DOB">@L["PatientDetails.DateOfBirth"] <span class="required">*</span></label>
                                <input asp-for="Form.NewPatient.DOB" id="Form_DOB" type="date" autocomplete="bday" />
                            </div>
                            <div class="form-group">
                                <label>@L["PatientDetails.Gender"] <span class="required">*</span></label>
                                <div class="gender-row" role="group" aria-label="@L["PatientDetails.Gender"]">
                                    <button type="button" class="gender-btn" data-value="Male" onclick="selGender(this)">@L["Gender.Male"]</button>
                                    <button type="button" class="gender-btn" data-value="Female" onclick="selGender(this)">@L["Gender.Female"]</button>
                                    <button type="button" class="gender-btn" data-value="Other" onclick="selGender(this)">@L["Gender.Other"]</button>
                                </div>
                                <span id="gender-error" class="field-error" style="display:none">@L["Validation.SelectGender"]</span>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="Form_Email">@L["PatientDetails.Email"]</label>
                                <input asp-for="Form.NewPatient.Email" id="Form_Email" type="email" placeholder="patient@email.com" autocomplete="email" />
                            </div>
                            <div class="form-group">
                                <label for="Form_BloodGroup">@L["PatientDetails.BloodGroup"]</label>
                                <select asp-for="Form.NewPatient.BloodGroup" id="Form_BloodGroup">
                                    <option value="">@L["PatientDetails.SelectBloodGroup"]</option>
                                    <option>A+</option>
                                    <option>A−</option>
                                    <option>B+</option>
                                    <option>B−</option>
                                    <option>O+</option>
                                    <option>O−</option>
                                    <option>AB+</option>
                                    <option>AB−</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-row form-row-single">
                            <div class="form-group">
                                <label for="Form_Address">@L["PatientDetails.Address"]</label>
                                <input asp-for="Form.NewPatient.Address" id="Form_Address" type="text" placeholder="@L["PatientDetails.AddressPlaceholder"]" autocomplete="street-address" />
                            </div>
                        </div>

                        <div class="form-row form-row-3">
                            <div class="form-group">
                                <label for="Form_Country">@L["PatientDetails.Country"]</label>
                                <select id="Form_Country" name="Form.CountryName">
                                    <option value="">@L["Js.SelectCountry"]</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="Form_State">@L["PatientDetails.State"]</label>
                                <select id="Form_State" disabled>
                                    <option value="">@L["Js.SelectState"]</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="Form_City">@L["PatientDetails.City"]</label>
                                <select id="Form_City" disabled>
                                    <option value="">@L["Js.SelectCity"]</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-row-pincode">
                            <div class="form-group">
                                <label for="Form_Pincode">@L["PatientDetails.Pincode"]</label>
                                <input asp-for="Form.NewPatient.Pincode" id="Form_Pincode" type="text" inputmode="numeric" maxlength="6" placeholder="@L["PatientDetails.PincodePlaceholder"]" autocomplete="postal-code" />
                            </div>
                            <div></div>
                        </div>

                        <div class="divider"></div>

                        <div class="section-title">
                            <span aria-hidden="true">📱</span> @L["PatientDetails.MobileVerification"]
                            <span class="verify-badge" id="verify-badge">@L["Common.Verified"]</span>
                        </div>

                        <div class="phone-row">
                            <div class="form-group country-code">
                                <label for="Form_CountryCode">@L["PatientDetails.Code"]</label>
                                <input asp-for="Form.NewPatient.CountryCode" id="Form_CountryCode" type="text" value="+91" maxlength="4" />
                            </div>
                            <div class="form-group phone-number-group">
                                <label for="phone-input">@L["PatientDetails.MobileNumber"] <span class="required">*</span></label>
                                <input type="tel" id="phone-input" placeholder="98XXXXXXXX" maxlength="10" inputmode="numeric" autocomplete="tel-national"
                                       oninput="checkPhone()" value="@Model.Form.NewPatient.Mobile" />
                            </div>
                            <button type="button" class="send-otp-btn" id="send-otp-btn" onclick="sendOTP()" disabled>
                                @L["Js.SendOtp"]
                            </button>
                        </div>

                        <div class="otp-section" id="otp-section">
                            <div class="otp-hint">
                                @L.Html("PatientDetails.OtpSentTo", "<strong id=\"otp-phone-display\"></strong>")
                            </div>
                            <div class="otp-inputs" id="new-otp-inputs"></div>
                            <div class="otp-verified" id="otp-verified">@L["PatientDetails.MobileVerified"]</div>
                            <div class="resend-row">
                                <button type="button" class="resend-link" id="resend-btn" onclick="resendOTP()">@L["PatientDetails.ResendOtp"]</button>
                                <span class="timer" id="timer-display" aria-live="polite"></span>
                            </div>
                        </div>

                    </div>

                    @* ════════════════ REGISTERED PATIENT FORM ════════════════ *@
                    <div id="registered-form" style="display:none">

                        <input type="hidden" asp-for="Form.RegisteredPatient.IsMobileVerified" id="Reg_IsMobileVerified" />
                        <input type="hidden" asp-for="Form.RegisteredPatient.GuestPatientId" id="Reg_GuestPatientId" />
                        <input type="hidden" asp-for="Form.RegisteredPatient.RegistrationNo" id="Reg_RegistrationNo" />
                        <input type="hidden" asp-for="Form.RegisteredPatient.TitleName" id="Reg_TitleName" />
                        <input type="hidden" asp-for="Form.RegisteredPatient.TitleId" id="Reg_TitleId" />
                        <input type="hidden" asp-for="Form.RegisteredPatient.FirstName" id="Reg_FirstName" />
                        <input type="hidden" asp-for="Form.RegisteredPatient.MiddleName" id="Reg_MiddleName" />
                        <input type="hidden" asp-for="Form.RegisteredPatient.LastName" id="Reg_LastName" />
                        <input type="hidden" asp-for="Form.RegisteredPatient.Gender" id="Reg_Gender" />
                        <input type="hidden" asp-for="Form.RegisteredPatient.DOB" id="Reg_DOB" />
                        <input type="hidden" asp-for="Form.RegisteredPatient.Email" id="Reg_Email" />

                        <p class="existing-note">
                            @L["PatientDetails.RegisteredNote"]
                        </p>

                        <div class="phone-row">
                            <div class="form-group country-code">
                                <label for="reg-country-code">@L["PatientDetails.Code"]</label>
                                <input type="text" id="reg-country-code" value="+91" maxlength="4" />
                            </div>
                            <div class="form-group phone-number-group">
                                <label for="reg-phone-input">@L["PatientDetails.RegisteredMobile"] <span class="required">*</span></label>
                                <input type="tel" id="reg-phone-input" name="Form.RegisteredPatient.Mobile"
                                       placeholder="98XXXXXXXX" maxlength="10" inputmode="numeric" autocomplete="tel-national"
                                       oninput="checkRegPhone()" value="@Model.Form.RegisteredPatient.Mobile" />
                            </div>
                            <button type="button" class="send-otp-btn" id="reg-send-otp-btn" onclick="sendRegisteredOTP()" disabled>
                                @L["Js.SendOtp"]
                            </button>
                        </div>

                        <div class="otp-section" id="reg-otp-section">
                            <div class="otp-hint">
                                @L.Html("PatientDetails.OtpSentTo", "<strong id=\"reg-otp-phone-display\"></strong>")
                            </div>
                            <div class="otp-inputs" id="reg-otp-inputs"></div>
                            <div class="otp-verified" id="reg-otp-verified">@L["PatientDetails.MobileVerified"]</div>
                            <div class="resend-row">
                                <button type="button" class="resend-link" id="reg-resend-btn" onclick="resendRegisteredOTP()">@L["PatientDetails.ResendOtp"]</button>
                                <span class="timer" id="reg-timer-display" aria-live="polite"></span>
                            </div>
                        </div>

                        @* Family members on this mobile — cards built by patient-details.js (renderPatientCards) *@
                        <div id="patient-found-card" style="display:none">
                            <div class="pf-list-head">
                                <div>
                                    <div class="pf-list-title">@L["PatientDetails.SelectPatient"]</div>
                                    <div class="pf-list-sub" id="pf-list-sub"></div>
                                </div>
                                <div class="pf-verified-badge">@L["Common.Verified"]</div>
                            </div>
                            <div class="pf-list" id="pf-list" role="radiogroup" aria-label="@L["PatientDetails.SelectPatient"]"></div>
                            <span id="reg-patient-error" class="field-error" role="alert" style="display:none"></span>

                            @* New member under the same mobile — form in #familyModal (MobSaveRegistrationForPatient) *@
                            <button type="button" class="pf-add-btn" id="pf-add-btn" aria-haspopup="dialog">
                                <span class="pf-add-icon" aria-hidden="true">+</span>
                                <span class="pf-add-text">
                                    <span class="pf-add-title">@L["Family.AddMember"]</span>
                                    <span class="pf-add-sub">@L["Family.AddMemberSub"]</span>
                                </span>
                            </button>
                        </div>

                    </div>
                </div>

                @* Common — Appointment Notes *@
                <div class="section-card">
                    <div class="section-title"><span aria-hidden="true">📋</span> @L["PatientDetails.AppointmentNotes"]</div>
                    <div class="form-group">
                        <label for="Form_AppointmentNotes">@L["PatientDetails.NotesLabel"]</label>
                        <textarea asp-for="Form.AppointmentNotes" id="Form_AppointmentNotes" class="notes-textarea"
                                  placeholder="@L["PatientDetails.NotesPlaceholder"]" maxlength="300"
                                  oninput="countChars(this)"></textarea>
                        <div class="char-count"><span id="char-count">0</span> / 300</div>
                    </div>
                </div>

                @* Common — Consent *@
                <div class="section-card">
                    <div class="section-title"><span aria-hidden="true">🛡️</span> @L["PatientDetails.ConsentTitle"]</div>
                    <div class="consent-row">
                        <input asp-for="Form.ConsentTerms" id="Form_ConsentTerms" type="checkbox"
                               onchange="if(this.checked) document.getElementById('consent-error').style.display='none';" />
                        <label for="Form_ConsentTerms">
                            @L.Html("PatientDetails.AgreeTerms", termsLink, privacyLink)
                            <span class="required">*</span>
                        </label>
                    </div>
                    <span id="consent-error" class="field-error" style="display:none">@L["Validation.AcceptTerms"]</span>
                    <div class="consent-row mt-2">
                        <input asp-for="Form.ConsentMarketing" id="Form_ConsentMarketing" type="checkbox" />
                        <label for="Form_ConsentMarketing">@L["PatientDetails.AgreeMarketing"]</label>
                    </div>
                </div>

                @* Footer *@
                <div class="footer-actions">
                    <button type="submit" form="flowBack" class="btn-back">@L["Common.Back"]</button>
                    <button type="submit" id="submitBtn" class="btn-continue">@L["Js.ReviewConfirm"]</button>
                </div>

            </form>

            @* "← Back" submits this form (OnPostBack) — steps change only through buttons, never via the URL *@
            <form id="flowBack" method="post" action="?handler=Back" hidden>@Html.AntiForgeryToken()</form>
        </div>

    </div>

    @* ── Add family member (registered patient) — outside #patientForm, sent by patient-details.js (AddFamilyMember) ── *@
    <div class="fm-overlay" id="familyModal" role="dialog" aria-modal="true" aria-labelledby="familyModalTitle" hidden>
        <div class="fm-modal">
            <div class="fm-head">
                <div>
                    <div class="fm-title" id="familyModalTitle">@L["Family.AddMember"]</div>
                    <div class="fm-sub">@L.Html("Family.AddedUnder", "<strong id=\"fm-mobile\"></strong>")</div>
                </div>
                <button type="button" class="fm-close" data-fm-close aria-label="@L["Common.Close"]">✕</button>
            </div>

            <form class="fm-body" id="familyForm" novalidate>
                <div class="fm-error" id="fm-error" role="alert" hidden></div>

                <div class="form-row form-row-4">
                    <div class="form-group">
                        <label for="fm-title">@L["PatientDetails.Title"] <span class="required">*</span></label>
                        <select id="fm-title" data-field="title"><option value="">--</option></select>
                    </div>
                    <div class="form-group">
                        <label for="fm-first">@L["PatientDetails.FirstName"] <span class="required">*</span></label>
                        <input id="fm-first" data-field="firstName" type="text" maxlength="50" autocomplete="off" />
                    </div>
                    <div class="form-group">
                        <label for="fm-middle">@L["PatientDetails.MiddleName"]</label>
                        <input id="fm-middle" data-field="middleName" type="text" maxlength="50" autocomplete="off" />
                    </div>
                    <div class="form-group">
                        <label for="fm-last">@L["PatientDetails.LastName"] <span class="required">*</span></label>
                        <input id="fm-last" data-field="lastName" type="text" maxlength="50" autocomplete="off" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="fm-dob">@L["PatientDetails.DateOfBirth"] <span class="required">*</span></label>
                        <input id="fm-dob" data-field="dob" type="date" />
                    </div>
                    <div class="form-group">
                        <label>@L["PatientDetails.Gender"] <span class="required">*</span></label>
                        <div class="gender-row" id="fm-gender" data-field="gender" role="radiogroup" aria-label="@L["PatientDetails.Gender"]">
                            <button type="button" class="gender-btn" data-value="Male" role="radio" aria-checked="false">@L["Gender.Male"]</button>
                            <button type="button" class="gender-btn" data-value="Female" role="radio" aria-checked="false">@L["Gender.Female"]</button>
                            <button type="button" class="gender-btn" data-value="Other" role="radio" aria-checked="false">@L["Gender.Other"]</button>
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="fm-state">@L["PatientDetails.State"] <span class="required">*</span></label>
                        <select id="fm-state" data-field="state"><option value="">@L["Js.SelectState"]</option></select>
                    </div>
                    <div class="form-group">
                        <label for="fm-city">@L["PatientDetails.City"] <span class="required">*</span></label>
                        <select id="fm-city" data-field="city" disabled><option value="">@L["Js.SelectCity"]</option></select>
                    </div>
                </div>

                <div class="form-row form-row-single">
                    <div class="form-group">
                        <label for="fm-address">@L["PatientDetails.Address"]</label>
                        <input id="fm-address" data-field="address" type="text" maxlength="200" placeholder="@L["PatientDetails.AddressPlaceholder"]" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="fm-email">@L["PatientDetails.Email"]</label>
                        <input id="fm-email" data-field="email" type="email" maxlength="100" placeholder="patient@email.com" />
                    </div>
                    <div class="form-group">
                        <label for="fm-pincode">@L["PatientDetails.Pincode"]</label>
                        <input id="fm-pincode" data-field="pincode" type="text" inputmode="numeric" maxlength="6" placeholder="@L["PatientDetails.PincodePlaceholder"]" />
                    </div>
                </div>

            </form>

            <div class="fm-foot">
                <button type="button" class="btn-back" data-fm-close>@L["Common.Cancel"]</button>
                <button type="submit" form="familyForm" class="btn-continue" id="fm-save">@L["Js.SaveSelect"]</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/patient-details.js" asp-append-version="true"></script>
    <script>
        var OTP_LENGTH = @Model.Form.OtpLength;
        var DefaultCountryId = @Model.Form.CountryId;
        var SavedTitleName = @Html.Raw(Json.Serialize(Model.Form.NewPatient.TitleName ?? ""));
        var SavedTitleId = @Html.Raw(Json.Serialize(Model.Form.NewPatient.TitleId.ToString()));
        var SavedCountryName = @Html.Raw(Json.Serialize(Model.Form.CountryName ?? ""));
        var SavedStateName = @Html.Raw(Json.Serialize(Model.Form.NewPatient.StateName ?? ""));
        var SavedStateId = @Html.Raw(Json.Serialize(Model.Form.NewPatient.StateId?.ToString() ?? ""));
        var SavedCityName = @Html.Raw(Json.Serialize(Model.Form.NewPatient.CityName ?? ""));
        var SavedCityId = @Html.Raw(Json.Serialize(Model.Form.NewPatient.CityId?.ToString() ?? ""));
        var SavedPatientType = @Html.Raw(Json.Serialize(Model.Form.PatientType ?? ""));
        var SavedRegisteredPatients = @Html.Raw(Json.Serialize(Model.RegisteredPatients));
        var SavedSelectedPatient = @Model.SelectedPatientIndex;

        initPatientDetailsPage();
    </script>
}


@inject IConfiguration Configuration

<style>
    .custom-footer {
        background: linear-gradient(135deg, #0b1220 0%, #111c2f 100%);
        color: #dbe7f5;
        width: 100%;
        border-top: 1px solid rgba(255,255,255,.08);
    }

    .footer-inner {
        max-width: 1500px;
        margin: 0 auto;
        padding: 22px clamp(16px, 3vw, 42px) 18px;
    }

    .footer-disclaimer {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        font-size: 12px;
        line-height: 1.65;
        color: #c8d5e6;
    }

        .footer-disclaimer strong {
            color: #fff;
            white-space: nowrap;
        }

    .footer-divider {
        height: 1px;
        background: rgba(255,255,255,.10);
        margin: 16px 0 13px;
    }

    .footer-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        flex-wrap: wrap;
    }

    .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 28px;
    }

        .footer-links a {
            color: #8ec5ff;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            transition: color .2s ease;
        }

            .footer-links a:hover {
                color: #fff;
            }

    .footer-security {
        color: #8ea2bb;
        font-size: 12px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

    @@media (max-width: 640px) {
        .footer-inner {
            padding: 18px 15px;
        }

        .footer-disclaimer {
            font-size: 11px;
        }

            .footer-disclaimer strong {
                display: block;
            }

        .footer-bottom {
            align-items: flex-start;
        }

        .footer-links {
            gap: 10px 18px;
        }
    }
</style>

<footer class="custom-footer">
    <div class="footer-inner">
        <div class="footer-disclaimer">
            <strong>Disclaimer:</strong>
            <span>
                @Configuration["HospitalSettings:DisclaimerText"]
                For Panel (Any Government Panel cash/Credit) Patients, please call
                Sector 14: @Configuration["HospitalSettings:FooterPhone1"],
                Sector 56: @Configuration["HospitalSettings:FooterPhone2"],
                Sector 82: @Configuration["HospitalSettings:FooterPhone3"]
                to take appointment.
            </span>
        </div>

        <div class="footer-divider"></div>

        <div class="footer-bottom">
            <div class="footer-links">
                <a href="@Configuration["HospitalSettings:AboutUsUrl"]">About us</a>
                <a href="@Configuration["HospitalSettings:TermsUrl"]">Terms of Use</a>
                <a href="@Configuration["HospitalSettings:RefundPolicyUrl"]">Refund &amp; Cancellations Policy</a>
                <a href="@Configuration["HospitalSettings:PrivacyPolicyUrl"]">Privacy policy</a>
            </div>

            <div class="footer-security">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                Secure patient portal
            </div>
        </div>
    </div>
</footer>





@inject IConfiguration Configuration
@{
    // Everything here comes from appsettings: links = HospitalSettings, the rest = FooterSettings (see Docs/Footer.md).
    // Every part has a Show… switch in FooterSettings (missing = shown); a link / badge also needs its URL.
    var hs = Configuration.GetSection("HospitalSettings");
    var fs = Configuration.GetSection("FooterSettings");
    bool Show(string key) => fs.GetValue(key, true);

    var links = new List<(string Url, string Text)>();
    void AddLink(string flag, string? url, string textKey)
    {
        if (Show(flag) && !string.IsNullOrWhiteSpace(url)) links.Add((url.Trim(), L[textKey]));
    }
    AddLink("ShowAboutUs", hs["AboutUsUrl"], "Footer.AboutUs");
    AddLink("ShowContactUs", hs["ContactUs"] ?? hs["ContactUsUrl"], "Footer.ContactUs");
    AddLink("ShowTerms", hs["TermsUrl"], "Footer.TermsOfUse");
    AddLink("ShowRefundPolicy", hs["RefundPolicyUrl"], "Footer.RefundPolicy");
    AddLink("ShowPrivacyPolicy", hs["PrivacyPolicyUrl"], "Footer.PrivacyPolicy");

    // Links to another site open in a new tab, so the patient does not lose the booking in progress
    static bool IsExternal(string url) => url.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
                                          || url.StartsWith("https://", StringComparison.OrdinalIgnoreCase);

    var showDisclaimer = Show("ShowDisclaimer");
    var collapsed = fs.GetValue("DisclaimerCollapsed", true);
    var disclaimer = L.ConfigText("Footer.DisclaimerText", hs["DisclaimerText"]);
    if (fs.GetValue("ShowPanelPhones", false) && !string.IsNullOrWhiteSpace(hs["FooterPhone1"]))
        disclaimer += " " + L["Footer.PanelPatients", hs["FooterPhone1"] ?? "", hs["FooterPhone2"] ?? "", hs["FooterPhone3"] ?? ""];
    showDisclaimer = showDisclaimer && !string.IsNullOrWhiteSpace(disclaimer);

    var playUrl = Show("ShowGooglePlay") ? fs["GooglePlayUrl"]?.Trim() : null;
    var appStoreUrl = Show("ShowAppStore") ? fs["AppStoreUrl"]?.Trim() : null;
    var hasStores = !string.IsNullOrEmpty(playUrl) || !string.IsNullOrEmpty(appStoreUrl);

    var copyrightName = Show("ShowCopyright") ? fs["CopyrightName"]?.Trim().TrimEnd('.') : null;   // "Pvt. Ltd." + ". All rights…" → no double dot
    var copyrightYear = string.IsNullOrWhiteSpace(fs["CopyrightYear"]) ? DateTime.Now.Year.ToString() : fs["CopyrightYear"]!.Trim();
    var showSecure = Show("ShowSecureBadge");

    // Nothing left to show (or the whole footer switched off) → no empty dark bar
    var footerOn = Show("Enabled") &&
                   (showDisclaimer || links.Count > 0 || hasStores || !string.IsNullOrEmpty(copyrightName) || showSecure);
}
@if (!footerOn) { return; }

<style>
    .custom-footer {
        background: linear-gradient(135deg, var(--footer-bg) 0%, var(--footer-bg-2) 100%);
        color: var(--footer-text);
        width: 100%;
        border-top: 1px solid rgba(255,255,255,.08);
        font-size: 13px;
    }

    .footer-inner {
        max-width: 1500px;
        margin: 0 auto;
        padding: 14px clamp(16px, 3vw, 42px) 14px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    /* ── Disclaimer: one line + "Read more" (or full text when not collapsed) ── */
    .footer-disclaimer {
        font-size: 12px;
        line-height: 1.6;
        color: var(--footer-text-soft);
    }

        .footer-disclaimer strong { color: #fff; margin-right: 6px; }

        .footer-disclaimer summary {
            list-style: none;
            cursor: pointer;
            display: flex;
            align-items: baseline;
            gap: 8px;
            min-width: 0;
        }

            .footer-disclaimer summary::-webkit-details-marker { display: none; }

        .footer-disclaimer .fd-text {
            flex: 1;
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .footer-disclaimer[open] .fd-text { white-space: normal; overflow-wrap: anywhere; }

        .footer-disclaimer .fd-toggle {
            flex-shrink: 0;
            color: var(--footer-link);
            font-weight: 600;
            white-space: nowrap;
        }

            .footer-disclaimer .fd-toggle .fd-less,
            .footer-disclaimer[open] .fd-toggle .fd-more { display: none; }

            .footer-disclaimer[open] .fd-toggle .fd-less { display: inline; }

        .footer-disclaimer summary:focus-visible { outline: 2px solid var(--footer-link); outline-offset: 3px; border-radius: 4px; }

    .footer-divider {
        height: 1px;
        background: rgba(255,255,255,.10);
    }

    /* ── Links + store badges ── */
    .footer-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px 20px;
        flex-wrap: wrap;
    }

    .footer-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px 22px;
    }

        .footer-links a {
            color: var(--footer-link);
            text-decoration: none;
            font-weight: 600;
            transition: color .2s ease;
        }

            .footer-links a:hover { color: #fff; }

    .footer-stores {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .store-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        height: 38px;
        padding: 0 12px 0 10px;
        border-radius: 8px;
        background: #000;
        border: 1px solid rgba(255,255,255,.35);
        color: #fff;
        text-decoration: none;
        line-height: 1.05;
        transition: border-color .2s ease, transform .2s ease;
    }

        .store-badge:hover { border-color: #fff; color: #fff; transform: translateY(-1px); }
        .store-badge svg { width: 20px; height: 20px; flex-shrink: 0; }
        .store-badge small { display: block; font-size: 9px; letter-spacing: .02em; opacity: .85; }
        .store-badge b { display: block; font-size: 14px; font-weight: 600; }

    /* ── Copyright + secure ── */
    .footer-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 6px 18px;
        flex-wrap: wrap;
        font-size: 12px;
        color: var(--footer-text-muted);
    }

    .footer-security {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    /* ── Mobile / app: centred, short ── */
    @@media (max-width: 640px) {
        .footer-inner { padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px)); gap: 8px; }

        .footer-row,
        .footer-bottom { flex-direction: column; justify-content: center; text-align: center; }

        .footer-row { gap: 8px; }
        .footer-bottom { gap: 2px; font-size: 11.5px; }

        .footer-links { justify-content: center; gap: 0 14px; font-size: 12.5px; }
            .footer-links a { padding: 5px 0; }   /* comfortable tap targets */

        .footer-stores { justify-content: center; }
        .store-badge { height: 34px; }
    }
</style>

<footer class="custom-footer">
    <div class="footer-inner">
        @if (showDisclaimer)
        {
            if (collapsed)
            {
                <details class="footer-disclaimer">
                    <summary>
                        <span class="fd-text"><strong>@L["Footer.Disclaimer"]</strong>@disclaimer</span>
                        <span class="fd-toggle"><span class="fd-more">@L["Footer.ReadMore"]</span><span class="fd-less">@L["Footer.ReadLess"]</span></span>
                    </summary>
                </details>
            }
            else
            {
                <div class="footer-disclaimer"><strong>@L["Footer.Disclaimer"]</strong>@disclaimer</div>
            }
            <div class="footer-divider"></div>
        }

        @if (links.Count > 0 || hasStores)
        {
            <div class="footer-row">
                <nav class="footer-links" aria-label="@L["Footer.Links"]">
                    @foreach (var link in links)
                    {
                        if (IsExternal(link.Url))
                        {
                            <a href="@link.Url" target="_blank" rel="noopener noreferrer">@link.Text</a>
                        }
                        else
                        {
                            <a href="@link.Url">@link.Text</a>
                        }
                    }
                </nav>

                @if (hasStores)
                {
                    <div class="footer-stores">
                        @if (!string.IsNullOrEmpty(playUrl))
                        {
                            <a class="store-badge" href="@playUrl" target="_blank" rel="noopener noreferrer" aria-label="@L["Footer.GetItOn"] Google Play">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path fill="#00d7fe" d="M3.6 1.8 13.4 12 3.6 22.2c-.4-.2-.6-.6-.6-1.1V2.9c0-.5.2-.9.6-1.1z" />
                                    <path fill="#ffce00" d="M16.8 8.6l3.5 2c1 .6 1 2.1 0 2.7l-3.5 2-3.4-3.3z" />
                                    <path fill="#00f076" d="M3.6 1.8c.3-.2.8-.2 1.2 0l12 6.8-3.4 3.4z" />
                                    <path fill="#f83f54" d="M13.4 12l3.4 3.4-12 6.8c-.4.2-.9.2-1.2 0z" />
                                </svg>
                                <span><small>@L["Footer.GetItOn"]</small><b>Google Play</b></span>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(appStoreUrl))
                        {
                            <a class="store-badge" href="@appStoreUrl" target="_blank" rel="noopener noreferrer" aria-label="@L["Footer.DownloadOn"] App Store">
                                <svg viewBox="0 0 24 24" fill="#fff" aria-hidden="true">
                                    <path d="M16.37 12.65c-.02-2.2 1.8-3.26 1.88-3.31-1.03-1.5-2.62-1.7-3.18-1.73-1.35-.14-2.64.8-3.33.8-.69 0-1.74-.78-2.86-.76-1.47.02-2.83.86-3.59 2.17-1.53 2.66-.39 6.6 1.1 8.76.73 1.06 1.6 2.24 2.73 2.2 1.1-.04 1.51-.71 2.84-.71 1.32 0 1.7.71 2.86.69 1.18-.02 1.93-1.07 2.65-2.13.84-1.22 1.18-2.41 1.2-2.47-.03-.01-2.28-.88-2.3-3.47zM14.2 6.19c.6-.73 1.01-1.75.9-2.76-.87.04-1.92.58-2.54 1.31-.56.64-1.05 1.67-.92 2.66.97.08 1.96-.49 2.56-1.21z" />
                                </svg>
                                <span><small>@L["Footer.DownloadOn"]</small><b>App Store</b></span>
                            </a>
                        }
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(copyrightName) || showSecure)
        {
            <div class="footer-bottom">
                @if (!string.IsNullOrEmpty(copyrightName))
                {
                    <span>@L["Footer.Copyright", copyrightYear, copyrightName]</span>
                }
                @if (showSecure)
                {
                    <span class="footer-security">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        @L["Footer.SecurePortal"]
                    </span>
                }
            </div>
        }
    </div>
</footer>

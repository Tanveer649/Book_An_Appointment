@inject IConfiguration Configuration

<style>
    .custom-footer {
        background: linear-gradient(135deg, #0b1220 0%, #111c2f 100%);
        color: #dbe7f5;
        width: 100%;
        border-top: 1px solid rgba(255,255,255,.08);
    }

    .footer-inner {
        max-width: 1500px;
        margin: 0 auto;
        padding: 22px clamp(16px, 3vw, 42px) 18px;
    }

    .footer-disclaimer {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        font-size: 12px;
        line-height: 1.65;
        color: #c8d5e6;
    }

        .footer-disclaimer strong {
            color: #fff;
            white-space: nowrap;
        }

        .footer-disclaimer span {
            min-width: 0;
            overflow-wrap: anywhere;
        }

    .footer-divider {
        height: 1px;
        background: rgba(255,255,255,.10);
        margin: 16px 0 13px;
    }

    .footer-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px 18px;
        flex-wrap: wrap;
    }

    .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 28px;
    }

        .footer-links a {
            color: #8ec5ff;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            transition: color .2s ease;
        }

            .footer-links a:hover {
                color: #fff;
            }

    .footer-security {
        color: #8ea2bb;
        font-size: 12px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

    /* ── Tablet ── */
    @@media (max-width: 900px) {
        .footer-links {
            gap: 8px 22px;
        }
    }

    /* ── Mobile ── */
    @@media (max-width: 640px) {
        .footer-inner {
            padding: 18px 16px 20px;
        }

        .footer-disclaimer {
            flex-direction: column;
            gap: 4px;
            font-size: 12px;
        }

        .footer-divider {
            margin: 14px 0 10px;
        }

        .footer-bottom {
            flex-direction: column;
            align-items: flex-start;
        }

        .footer-links {
            width: 100%;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0 16px;
        }

            .footer-links a {
                padding: 9px 0;
                line-height: 1.35;
            }
        /* comfortable tap targets */
    }

    /* ── Very small phones ── */
    @@media (max-width: 360px) {
        .footer-links {
            grid-template-columns: 1fr;
        }
    }
</style>

<footer class="custom-footer">
    <div class="footer-inner">
        <div class="footer-disclaimer">
            <strong>@L["Footer.Disclaimer"]</strong>
            <span>
                @L.ConfigText("Footer.DisclaimerText", Configuration["HospitalSettings:DisclaimerText"])
                @L["Footer.PanelPatients",
                    Configuration["HospitalSettings:FooterPhone1"] ?? "",
                    Configuration["HospitalSettings:FooterPhone2"] ?? "",
                    Configuration["HospitalSettings:FooterPhone3"] ?? ""]
            </span>
        </div>

        <div class="footer-divider"></div>

        <div class="footer-bottom">
            <div class="footer-links">
                <a href="@Configuration["HospitalSettings:AboutUsUrl"]">@L["Footer.AboutUs"]</a>
                <a href="@Configuration["HospitalSettings:TermsUrl"]">@L["Footer.TermsOfUse"]</a>
                <a href="@Configuration["HospitalSettings:RefundPolicyUrl"]">@L["Footer.RefundPolicy"]</a>
                <a href="@Configuration["HospitalSettings:PrivacyPolicyUrl"]">@L["Footer.PrivacyPolicy"]</a>
            </div>

            <div class="footer-security">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                @L["Footer.SecurePortal"]
            </div>
        </div>
    </div>
</footer>

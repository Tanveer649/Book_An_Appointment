@inject IConfiguration Configuration
@{
    // Logo size from config is passed as CSS variables (not inline width/height),
    // so the responsive rules below can still resize the logo on small screens.
    var logoW = Configuration["HospitalSettings:LogoWidth"];
    var logoH = Configuration["HospitalSettings:LogoHeight"];
    var logoStyle = (string.IsNullOrWhiteSpace(logoW) ? "" : $"--logo-w:{logoW};")
                  + (string.IsNullOrWhiteSpace(logoH) ? "" : $"--logo-h:{logoH};");
    var headerText = Configuration["HospitalSettings:HeaderText"];
    var emergency = Configuration["HospitalSettings:EmergencyNumber"];
}

<style>
    .hospital-header {
        width: 100%;
        background: #ffffff;
        border-top: 2px solid #0b78b5;
        border-bottom: 1px solid #e5eaf0;
        box-shadow: 0 2px 8px rgba(15, 40, 70, 0.05);
        border-radius: 0 0 10px 10px;
    }

    .hospital-header-inner {
        width: 100%;
        min-height: 78px;
        padding: 8px clamp(12px, 2.5vw, 42px);
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
        align-items: center;
        gap: 30px;
    }

    /* ── Left: logo + name ─────────────────────────────── */
    .hospital-brand {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
    }

    .hospital-logo {
        width: var(--logo-w, 58px);
        height: var(--logo-h, 58px);
        max-width: 100%;
        object-fit: contain;
        flex-shrink: 0;
    }

    .hospital-name {
        color: #172f4d;
        font-size: clamp(16px, 1.9vw, 27px);
        font-weight: 600;
        line-height: 1.2;
        letter-spacing: -0.3px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        min-width: 0;
    }

    /* ── Center: title ─────────────────────────────────── */
    .header-title {
        text-align: center;
        color: #1167b1;
        font-size: clamp(24px, 2.5vw, 36px);
        font-weight: 550;
        line-height: 1.2;
        letter-spacing: -0.5px;
        white-space: nowrap;
    }

    /* ── Right: emergency ──────────────────────────────── */
    .emergency-section {
        justify-self: end;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .emergency-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #dc3545;
        border: 1px solid #f1c9ce;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .emergency-info {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
    }

    .emergency-label {
        color: #dc3545;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.4px;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .emergency-number {
        color: #203550;
        font-size: 17px;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
    }

        .emergency-number:hover {
            color: #1167b1;
        }

    /* ── Large screens ─────────────────────────────────── */
    @@media (min-width: 1600px) {
        .hospital-header-inner {
            min-height: 82px;
        }
    }

    /* ── Tablet ────────────────────────────────────────── */
    @@media (max-width: 1000px) {
        .hospital-header-inner {
            gap: 18px;
        }

        .hospital-logo {
            width: 52px;
            height: 52px;
        }

        .emergency-icon {
            width: 34px;
            height: 34px;
        }

        .emergency-number {
            font-size: 15px;
        }
    }

    /* ── Small tablet / large phone: title moves to its own row ── */
    @@media (max-width: 800px) {
        .hospital-header-inner {
            grid-template-columns: minmax(0, 1fr) auto;
            grid-template-areas: "brand emergency" "title title";
            gap: 8px 14px;
        }

        .hospital-brand {
            grid-area: brand;
        }

        .emergency-section {
            grid-area: emergency;
        }

        .header-title {
            grid-area: title;
            font-size: 22px;
            padding-top: 8px;
            border-top: 1px solid #eef2f6;
            white-space: normal;
        }
    }

    /* ── Mobile ────────────────────────────────────────── */
    @@media (max-width: 600px) {
        .hospital-header-inner {
            min-height: 0;
            padding: 8px 12px;
        }

        .hospital-brand {
            gap: 10px;
        }

        .hospital-logo {
            width: 42px;
            height: 42px;
        }

        .hospital-name {
            font-size: 15px;
            letter-spacing: 0;
            white-space: normal;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }

        .emergency-section {
            gap: 7px;
        }

        .emergency-icon {
            width: 30px;
            height: 30px;
        }

            .emergency-icon svg {
                width: 15px;
                height: 15px;
            }

        .emergency-label {
            font-size: 9px;
            letter-spacing: 1px;
            margin-bottom: 2px;
        }

        .emergency-number {
            font-size: 13px;
            padding: 2px 0;
        }

        .header-title {
            font-size: 19px;
        }
    }

    /* ── Very small phones ─────────────────────────────── */
    @@media (max-width: 380px) {
        .hospital-logo {
            width: 38px;
            height: 38px;
        }

        .hospital-name {
            font-size: 14px;
        }

        .emergency-icon {
            display: none;
        }

        .emergency-number {
            font-size: 12.5px;
        }

        .header-title {
            font-size: 17px;
        }
    }
</style>

<header class="hospital-header">
    <div class="hospital-header-inner">

        <div class="hospital-brand">
            <img src="@Configuration["HospitalSettings:LogoPath"]"
                 alt="@Configuration["HospitalSettings:HospitalName"]"
                 class="hospital-logo"
                 style="@logoStyle" />
            <div class="hospital-name" title="@Configuration["HospitalSettings:HospitalName"]">
                @Configuration["HospitalSettings:HospitalName"]
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(headerText))
        {
            <div class="header-title">@headerText</div>
        }

        <div class="emergency-section">
            <div class="emergency-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
            </div>
            <div class="emergency-info">
                <div class="emergency-label">Emergency</div>
                <a href="tel:@emergency" class="emergency-number">@emergency</a>
            </div>
        </div>

    </div>
</header>

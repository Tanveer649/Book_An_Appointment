@inject IConfiguration Configuration
@{
    // Logo size from config is passed as CSS variables (not inline width/height), so the rules below
    // keep it inside safe limits (32–60 px high, max 200 px wide) and still resize it on small screens.
    // Recommended: LogoHeight "56px", LogoWidth "auto" — see Docs/Deploy-New-Client.md
    var logoW = Configuration["HospitalSettings:LogoWidth"];
    var logoH = Configuration["HospitalSettings:LogoHeight"];
    var logoStyle = (string.IsNullOrWhiteSpace(logoW) ? "" : $"--logo-w:{logoW};")
                  + (string.IsNullOrWhiteSpace(logoH) ? "" : $"--logo-h:{logoH};");
    var headerText = L.ConfigText("Header.Title", Configuration["HospitalSettings:HeaderText"]);
    var emergency = Configuration["HospitalSettings:EmergencyNumber"];

    // Language dropdown: every language from appsettings LanguageSettings; returns to the same page
    var currentLanguage = Languages.Current;
    var returnUrl = BookingFlow.PublicPath(Context);   // current step URL, e.g. /patientdetails/{id}
}

<style>
    .hospital-header {
        width: 100%;
        background: #ffffff;
        border-top: 2px solid var(--primary);
        border-bottom: 1px solid var(--line);
        box-shadow: 0 2px 8px rgba(15, 40, 70, 0.05);
        border-radius: 0 0 10px 10px;
    }

    .hospital-header-inner {
        width: 100%;
        min-height: 78px;
        padding: 8px clamp(12px, 2.5vw, 42px);
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
        align-items: center;
        gap: 30px;
    }

    /* ── Left: logo + name ─────────────────────────────── */
    .hospital-brand {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
    }

    /* Logo stays inside a safe box whatever the image size / shape or the config values:
       height from HospitalSettings:LogoHeight but kept between 32 and 60 px (header height never changes), width follows the image
       (or LogoWidth) up to 200 px, never stretched or cropped (object-fit: contain). */
    .hospital-logo {
        display: block;
        height: clamp(32px, var(--logo-h, 56px), 60px);
        width: var(--logo-w, auto);
        max-width: min(200px, 28vw);
        max-height: 60px;
        object-fit: contain;
        object-position: left center;
        flex-shrink: 0;
    }

    .hospital-name {
        color: var(--ink);
        font-size: clamp(16px, 1.9vw, 27px);
        font-weight: 600;
        line-height: 1.2;
        letter-spacing: -0.3px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        min-width: 0;
    }

    /* ── Center: title ─────────────────────────────────── */
    .header-title {
        text-align: center;
        color: var(--primary);
        font-size: clamp(24px, 2.5vw, 36px);
        font-weight: 550;
        line-height: 1.2;
        letter-spacing: -0.5px;
        white-space: nowrap;
    }

    /* ── Right: language + emergency ───────────────────── */
    .header-actions {
        justify-self: end;
        display: flex;
        align-items: center;
        gap: 18px;
        min-width: 0;
    }

    .emergency-section {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-left: 18px;
        border-left: 1px solid var(--line);
    }

    .header-actions > .emergency-section:first-child {
        padding-left: 0;
        border-left: none;
    }

    /* Language picker — quiet pill, menu opens below */
    .lang-switch {
        position: relative;
    }

    .lang-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        height: 34px;
        padding: 0 10px 0 11px;
        background: #fff;
        color: var(--ink);
        border: 1px solid var(--line);
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
        line-height: 1;
        cursor: pointer;
        white-space: nowrap;
        transition: background .15s, border-color .15s;
    }

        .lang-btn:hover, .lang-btn[aria-expanded="true"] {
            background: var(--paper);
            border-color: var(--primary-border);
        }

        .lang-btn:focus-visible {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
        }

        .lang-btn .lang-globe {
            color: var(--primary);
            flex-shrink: 0;
        }

        .lang-btn .lang-chevron {
            color: var(--ink-faint);
            transition: transform .15s;
        }

        .lang-btn[aria-expanded="true"] .lang-chevron {
            transform: rotate(180deg);
        }

    .lang-code {
        display: none;
        text-transform: uppercase;
    }

    .lang-menu {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        z-index: 1050;
        min-width: 190px;
        margin: 0;
        padding: 6px;
        list-style: none;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 12px;
        box-shadow: 0 16px 32px -12px rgba(15, 40, 70, .25);
    }

        .lang-menu[hidden] {
            display: none;
        }

        .lang-menu a {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            padding: 9px 10px;
            border-radius: 8px;
            color: var(--ink);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
        }

            .lang-menu a:hover, .lang-menu a:focus-visible {
                background: var(--paper);
                outline: none;
            }

            .lang-menu a[aria-current="true"] {
                color: var(--primary);
                font-weight: 600;
            }

        .lang-menu .lang-en {
            font-size: 12px;
            font-weight: 400;
            color: var(--ink-faint);
        }

        .lang-menu .lang-check {
            color: var(--primary);
            font-size: 13px;
        }

    .emergency-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #dc3545;
        border: 1px solid #f1c9ce;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .emergency-info {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
    }

    .emergency-label {
        color: #dc3545;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.4px;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .emergency-number {
        color: var(--ink);
        font-size: 17px;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
    }

        .emergency-number:hover {
            color: var(--primary);
        }

    /* ── Large screens ─────────────────────────────────── */
    @@media (min-width: 1600px) {
        .hospital-header-inner {
            min-height: 82px;
        }
    }

    /* ── Tablet ────────────────────────────────────────── */
    @@media (max-width: 1000px) {
        .hospital-header-inner {
            gap: 18px;
        }

        .hospital-logo {
            height: clamp(32px, var(--logo-h, 56px), 52px);
            max-width: 160px;
        }

        .emergency-icon {
            width: 34px;
            height: 34px;
        }

        .emergency-number {
            font-size: 15px;
        }
    }

    /* ── Small tablet / large phone: title moves to its own row ── */
    @@media (max-width: 800px) {
        .hospital-header-inner {
            grid-template-columns: minmax(0, 1fr) auto;
            grid-template-areas: "brand emergency" "title title";
            gap: 8px 14px;
        }

        .hospital-brand {
            grid-area: brand;
        }

        .header-actions {
            grid-area: emergency;
            gap: 12px;
        }

        .emergency-section {
            padding-left: 12px;
        }

        .header-title {
            grid-area: title;
            font-size: 22px;
            padding-top: 8px;
            border-top: 1px solid var(--surface-soft);
            white-space: normal;
        }
    }

    /* ── Mobile ────────────────────────────────────────── */
    @@media (max-width: 600px) {
        .hospital-header-inner {
            min-height: 0;
            padding: 8px 12px;
        }

        .hospital-brand {
            gap: 10px;
        }

        .hospital-logo {
            height: 42px;
            max-width: 120px;
        }

        .hospital-name {
            font-size: 15px;
            letter-spacing: 0;
            white-space: normal;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }

        .emergency-section {
            gap: 7px;
            padding-left: 10px;
        }

        .header-actions {
            gap: 10px;
        }

        /* Phone: globe + short code only */
        .lang-btn {
            height: 30px;
            padding: 0 8px;
            gap: 5px;
            font-size: 12px;
        }

        .lang-name {
            display: none;
        }

        .lang-code {
            display: inline;
        }

        .lang-btn .lang-chevron {
            display: none;
        }

        .emergency-icon {
            width: 30px;
            height: 30px;
        }

            .emergency-icon svg {
                width: 15px;
                height: 15px;
            }

        .emergency-label {
            font-size: 9px;
            letter-spacing: 1px;
            margin-bottom: 2px;
        }

        .emergency-number {
            font-size: 13px;
            padding: 2px 0;
        }

        .header-title {
            font-size: 19px;
        }
    }

    /* ── Very small phones ─────────────────────────────── */
    @@media (max-width: 380px) {
        .hospital-logo {
            height: 36px;
            max-width: 96px;
        }

        .hospital-name {
            font-size: 14px;
        }

        .emergency-icon {
            display: none;
        }

        .emergency-number {
            font-size: 12.5px;
        }

        .header-title {
            font-size: 17px;
        }
    }
</style>

<header class="hospital-header">
    <div class="hospital-header-inner">

        <div class="hospital-brand">
            <img src="@Configuration["HospitalSettings:LogoPath"]"
                 alt="@Configuration["HospitalSettings:HospitalName"]"
                 class="hospital-logo"
                 style="@logoStyle"
                 onerror="this.style.display='none'" />
            <div class="hospital-name" title="@Configuration["HospitalSettings:HospitalName"]">
                @Configuration["HospitalSettings:HospitalName"]
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(headerText))
        {
            <div class="header-title">@headerText</div>
        }

        <div class="header-actions">

            @if (Languages.Languages.Count > 1)
            {
                <div class="lang-switch" id="langSwitch">
                    <button type="button" class="lang-btn" id="langBtn" aria-haspopup="true" aria-expanded="false"
                            aria-controls="langMenu" aria-label="@L["Header.ChangeLanguage"]: @currentLanguage.NativeName">
                        <svg class="lang-globe" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10" /><path d="M2 12h20" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                        </svg>
                        <span class="lang-name">@currentLanguage.NativeName</span>
                        <span class="lang-code" aria-hidden="true">@currentLanguage.Code.Split('-')[0]</span>
                        <svg class="lang-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="m6 9 6 6 6-6" />
                        </svg>
                    </button>
                    <ul class="lang-menu" id="langMenu" aria-label="@L["Header.Language"]" hidden>
                        @foreach (var lang in Languages.Languages)
                        {
                            var isCurrent = lang.Code == currentLanguage.Code;
                            <li>
                                <a href="/set-language?culture=@Uri.EscapeDataString(lang.Code)&amp;returnUrl=@Uri.EscapeDataString(returnUrl)"
                                   lang="@lang.Code" hreflang="@lang.Code" aria-current="@(isCurrent ? "true" : "false")">
                                    <span>
                                        @lang.NativeName
                                        @if (lang.NativeName != lang.Name)
                                        {
                                            <span class="lang-en" lang="en">@lang.Name</span>
                                        }
                                    </span>
                                    @if (isCurrent)
                                    {
                                        <span class="lang-check" aria-hidden="true">✓</span>
                                    }
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }

            <div class="emergency-section">
                <div class="emergency-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                    </svg>
                </div>
                <div class="emergency-info">
                    <div class="emergency-label">@L["Header.Emergency"]</div>
                    <a href="tel:@emergency" class="emergency-number">@emergency</a>
                </div>
            </div>

        </div>

    </div>
</header>

@if (Languages.Languages.Count > 1)
{
    <script>
        (function () {
            var btn = document.getElementById('langBtn');
            var menu = document.getElementById('langMenu');
            if (!btn || !menu) return;

            function items() { return Array.prototype.slice.call(menu.querySelectorAll('a')); }
            function open() {
                menu.hidden = false;
                btn.setAttribute('aria-expanded', 'true');
                (menu.querySelector('a[aria-current="true"]') || items()[0]).focus();
            }
            function close(focusBtn) {
                if (menu.hidden) return;
                menu.hidden = true;
                btn.setAttribute('aria-expanded', 'false');
                if (focusBtn) btn.focus();
            }

            btn.addEventListener('click', function () { menu.hidden ? open() : close(false); });
            document.addEventListener('click', function (e) {
                if (!document.getElementById('langSwitch').contains(e.target)) close(false);
            });
            document.addEventListener('keydown', function (e) {
                if (menu.hidden) return;
                if (e.key === 'Escape') { close(true); return; }
                if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
                    e.preventDefault();
                    var list = items(), i = list.indexOf(document.activeElement);
                    list[(i + (e.key === 'ArrowDown' ? 1 : -1) + list.length) % list.length].focus();
                }
            });
            // Back/forward cache: never come back with the menu open
            window.addEventListener('pageshow', function () { close(false); });
        })();
    </script>
}

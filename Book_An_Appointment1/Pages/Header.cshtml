@inject IConfiguration Configuration

<style>

    /* =========================================================
           HEADER
           ========================================================= */

    .hospital-header {
        width: 100%;
        background: #ffffff;
        border-top: 2px solid #0b78b5;
        border-bottom: 1px solid #e5eaf0;
        box-shadow: 0 2px 8px rgba(15, 40, 70, 0.05);
        border-radius: 0px 0px 10px 10px;
    }

    .hospital-header-inner {
        width: 100%;
        min-height: 78px;
        padding: 8px 32px;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 30px;
    }


    /* =========================================================
           LEFT - LOGO + HOSPITAL NAME
           ========================================================= */

    .hospital-brand {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
    }

    .hospital-logo {
        width: 58px;
        height: 58px;
        object-fit: contain;
        flex-shrink: 0;
    }

    .hospital-name {
        color: #172f4d;
        font-size: 25px;
        font-weight: 600;
        line-height: 1.2;
        letter-spacing: -0.3px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }


    /* =========================================================
           CENTER - BOOK APPOINTMENT
           ========================================================= */

    .header-title {
        text-align: center;
        color: #1167b1;
        font-size: 34px;
        font-weight: 550;
        line-height: 1.2;
        letter-spacing: -0.5px;
        white-space: nowrap;
    }


    /* =========================================================
           RIGHT - EMERGENCY
           ========================================================= */

    .emergency-section {
        justify-self: end;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .emergency-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #dc3545;
        border: 1px solid #f1c9ce;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .emergency-info {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
    }

    .emergency-label {
        color: #dc3545;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.4px;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .emergency-number {
        color: #203550;
        font-size: 17px;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
    }

        .emergency-number:hover {
            color: #1167b1;
        }


    /* =========================================================
           LARGE SCREEN
           ========================================================= */

    @@media (min-width: 1600px) {

        .hospital-header-inner {
            min-height: 82px;
            padding-left: 42px;
            padding-right: 42px;
        }

        .hospital-logo {
            width: 62px;
            height: 62px;
        }

        .hospital-name {
            font-size: 27px;
        }

        .header-title {
            font-size: 36px;
        }
    }


    /* =========================================================
           TABLET
           ========================================================= */

    @@media (max-width: 1000px) {

        .hospital-header-inner {
            padding: 8px 20px;
            gap: 18px;
        }

        .hospital-logo {
            width: 52px;
            height: 52px;
        }

        .hospital-name {
            font-size: 20px;
        }

        .header-title {
            font-size: 28px;
        }

        .emergency-icon {
            width: 34px;
            height: 34px;
        }

        .emergency-number {
            font-size: 15px;
        }
    }


    /* =========================================================
           SMALL TABLET
           ========================================================= */

    @@media (max-width: 800px) {

        .hospital-header-inner {
            grid-template-columns: 1fr auto;
        }

        .header-title {
            display: none;
        }

        .hospital-name {
            font-size: 20px;
        }
    }


    /* =========================================================
           MOBILE
           ========================================================= */

    @@media (max-width: 600px) {

        .hospital-header-inner {
            min-height: 64px;
            padding: 7px 12px;
            gap: 10px;
        }

        .hospital-brand {
            gap: 9px;
        }

        .hospital-logo {
            width: 44px;
            height: 44px;
        }

        .hospital-name {
            font-size: 16px;
            font-weight: 600;
            letter-spacing: 0;
        }

        .emergency-section {
            gap: 7px;
        }

        .emergency-icon {
            width: 30px;
            height: 30px;
        }

            .emergency-icon svg {
                width: 16px;
                height: 16px;
            }

        .emergency-label {
            font-size: 8px;
            letter-spacing: 1px;
            margin-bottom: 2px;
        }

        .emergency-number {
            font-size: 11px;
            font-weight: 600;
        }
    }


    /* =========================================================
           VERY SMALL MOBILE
           ========================================================= */

    @@media (max-width: 400px) {

        .hospital-name {
            max-width: 145px;
        }

        .emergency-icon {
            display: none;
        }

        .emergency-number {
            font-size: 10px;
        }
    }

</style>


<header class="hospital-header">

    <div class="hospital-header-inner">

        <!-- LEFT : LOGO + HOSPITAL NAME -->

        <div class="hospital-brand">

            <img src="@Configuration["HospitalSettings:LogoPath"]"
                 alt="@Configuration["HospitalSettings:HospitalName"]"
                 class="hospital-logo"
                 style="
            width:@Configuration["HospitalSettings:LogoWidth"];
            height:@Configuration["HospitalSettings:LogoHeight"];
            " />

            <div class="hospital-name">
                @Configuration["HospitalSettings:HospitalName"]
            </div>

        </div>


        <!-- CENTER : TITLE -->

        <div class="header-title">
            @Configuration["HospitalSettings:HeaderText"]
        </div>


        <!-- RIGHT : EMERGENCY -->

        <div class="emergency-section">

            <div class="emergency-icon">

                <svg width="18"
                     height="18"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2
                        19.79 19.79 0 0 1-8.63-3.07
                        19.5 19.5 0 0 1-6-6
                        19.79 19.79 0 0 1-3.07-8.67
                        A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72
                        12.84 12.84 0 0 0 .7 2.81
                        2 2 0 0 1-.45 2.11L8.09 9.91
                        a16 16 0 0 0 6 6l1.27-1.27
                        a2 2 0 0 1 2.11-.45
                        12.84 12.84 0 0 0 2.81.7
                        A2 2 0 0 1 22 16.92z">
                    </path>

                </svg>

            </div>


            <div class="emergency-info">

                <div class="emergency-label">
                    Emergency
                </div>

                <a href="tel:@Configuration["HospitalSettings:EmergencyNumber"]"
                       class="emergency-number">

                    @Configuration["HospitalSettings:EmergencyNumber"]

                </a>

            </div>

        </div>

    </div>

</header>




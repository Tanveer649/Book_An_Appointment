@page
@model Book_An_Appointment1.Pages.ReviewAndConfimation.ReviewAndConfirmationModel
@functions {
    // Whole rupees show without decimals (₹ 900); a fractional fee shows exactly (₹ 1.50) so the summary never misstates what is charged.
    static string Money(decimal v) => v == decimal.Truncate(v) ? v.ToString("N0") : v.ToString("N2");
}
@{
    ViewData["Title"] = "Review & Confirm";

    var isNewPatient = string.Equals(Model.Summary.PatientTypeDisplay, "New Patient", StringComparison.OrdinalIgnoreCase);
    var showRegFee = isNewPatient && Model.Summary.RegistrationFee > 0;
    var total = Model.Summary.ConsultationFee + (isNewPatient ? Model.Summary.RegistrationFee : 0);
}

@section Styles {
    <link rel="stylesheet" href="~/css/review-confirm.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/pages/review-confirm.js" asp-append-version="true"></script>
}

<div class="rc-page">

    @* ── Progress Bar ── *@
    <div class="progress-bar">
        <div class="step-item"><div class="step-circle done">✓</div><span class="step-label done">Select slot</span></div>
        <div class="step-connector done"></div>
        <div class="step-item"><div class="step-circle done">✓</div><span class="step-label done">Patient details</span></div>
        <div class="step-connector done"></div>
        <div class="step-item"><div class="step-circle active">3</div><span class="step-label active">Review &amp; confirm</span></div>
        <div class="step-connector"></div>
        <div class="step-item"><div class="step-circle pending">4</div><span class="step-label">Payment</span></div>
    </div>

    <div class="rc-header">
        <h1 class="rc-title">Review &amp; Confirm</h1>
        <p class="rc-sub">Please review your details before confirming the appointment</p>
    </div>

    <div class="rc-layout">

        <div class="rc-main">

            <div class="rc-info-box">
                <span class="rc-info-icon" aria-hidden="true">ℹ</span>
                <div>
                    <div class="rc-info-title">Please check all details carefully</div>
                    <div class="rc-info-sub">Once confirmed, you will receive an SMS/Email with your appointment details.</div>
                </div>
            </div>

            @* ── Appointment details ── *@
            <section class="rc-card">
                <div class="rc-card-header">
                    <h2 class="rc-card-title"><span class="rc-icon" aria-hidden="true">📋</span>Appointment details</h2>
                    <a asp-page="/Appointment/Appointment" class="rc-edit-btn"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg> Edit</a>
                </div>

                <div class="rc-detail-row">
                    <span class="rc-detail-icon" aria-hidden="true">🏥</span>
                    <span class="rc-detail-label">Hospital</span>
                    <span class="rc-detail-value">@Model.Summary.Hospital</span>
                </div>
                <div class="rc-detail-row">
                    <span class="rc-detail-icon" aria-hidden="true">🩺</span>
                    <span class="rc-detail-label">Specialty</span>
                    <span class="rc-detail-value">@Model.Summary.Specialisation</span>
                </div>
                <div class="rc-detail-row">
                    <span class="rc-detail-icon" aria-hidden="true">👨‍⚕️</span>
                    <span class="rc-detail-label">Doctor</span>
                    <span class="rc-detail-value">@Model.Summary.DoctorName</span>
                </div>
                <div class="rc-detail-row">
                    <span class="rc-detail-icon" aria-hidden="true">📅</span>
                    <span class="rc-detail-label">Appointment date</span>
                    <span class="rc-detail-value">
                        @(DateTime.TryParse(Model.Summary.SlotDate, out var sd) ? sd.ToString("ddd, dd MMM yyyy") : Model.Summary.SlotDate)
                    </span>
                </div>
                <div class="rc-detail-row">
                    <span class="rc-detail-icon" aria-hidden="true">🕐</span>
                    <span class="rc-detail-label">Appointment time</span>
                    <span class="rc-detail-value">
                        @(DateTime.TryParse(Model.Summary.SlotTime, out var st) ? st.ToString("hh:mm tt") : Model.Summary.SlotTime)
                    </span>
                </div>
                <div class="rc-detail-row">
                    <span class="rc-detail-icon" aria-hidden="true">💰</span>
                    <span class="rc-detail-label">Consultation fee</span>
                    <span class="rc-detail-value rc-fee">₹ @Money(Model.Summary.ConsultationFee)</span>
                </div>
            </section>

            @* ── Patient information ── *@
            <section class="rc-card">
                <div class="rc-card-header">
                    <h2 class="rc-card-title"><span class="rc-icon" aria-hidden="true">👤</span>Patient information</h2>
                    <div class="rc-card-header-right">
                        <span class="rc-verified-badge">✓ Verified</span>
                        <a asp-page="/PatientDetails/PatientDetails" class="rc-edit-btn"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg> Edit</a>
                    </div>
                </div>

                <div class="rc-patient-grid">
                    <div class="rc-patient-item">
                        <span class="rc-patient-label">Patient type</span>
                        <span class="rc-patient-value">@Model.Summary.PatientTypeDisplay</span>
                    </div>
                    <div class="rc-patient-item">
                        <span class="rc-patient-label">Full name</span>
                        <span class="rc-patient-value">@Model.Summary.FullName</span>
                    </div>
                    <div class="rc-patient-item">
                        <span class="rc-patient-label">Gender</span>
                        <span class="rc-patient-value">@Model.Summary.Gender</span>
                    </div>
                    <div class="rc-patient-item">
                        <span class="rc-patient-label">Date of birth</span>
                        <span class="rc-patient-value">@Model.Summary.FormattedDOB</span>
                    </div>
                    <div class="rc-patient-item">
                        <span class="rc-patient-label">Mobile number</span>
                        <span class="rc-patient-value">@Model.Summary.CountryCode @Model.Summary.Mobile</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Summary.Email))
                    {
                        <div class="rc-patient-item">
                            <span class="rc-patient-label">Email</span>
                            <span class="rc-patient-value">@Model.Summary.Email</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Summary.BloodGroup))
                    {
                        <div class="rc-patient-item">
                            <span class="rc-patient-label">Blood group</span>
                            <span class="rc-patient-value">@Model.Summary.BloodGroup</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Summary.Address))
                    {
                        <div class="rc-patient-item rc-full-width">
                            <span class="rc-patient-label">Address</span>
                            <span class="rc-patient-value">@Model.Summary.Address</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Summary.RegistrationNo))
                    {
                        <div class="rc-patient-item rc-full-width">
                            <span class="rc-patient-label">UHID</span>
                            <span class="rc-patient-value">@Model.Summary.RegistrationNo</span>
                        </div>
                    }
                </div>
            </section>

            @* ── Appointment notes ── *@
            <section class="rc-card">
                <div class="rc-card-header">
                    <h2 class="rc-card-title"><span class="rc-icon" aria-hidden="true">📝</span>Appointment notes</h2>
                    <a asp-page="/PatientDetails/PatientDetails" class="rc-edit-btn"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg> Edit</a>
                </div>
                <div class="rc-notes-label">Symptoms / Reason</div>
                @if (!string.IsNullOrWhiteSpace(Model.Summary.AppointmentNotes))
                {
                    <div class="rc-notes-text">@Model.Summary.AppointmentNotes</div>
                }
                else
                {
                    <div class="rc-notes-empty">No notes added</div>
                }
            </section>

        </div>

        <aside class="rc-aside">

            @* ── Payment summary ── *@
            <section class="rc-fee-card">
                <h2 class="rc-fee-title"><span aria-hidden="true">💳</span> Payment summary</h2>

                <div class="rc-fee-row">
                    <span>Consultation fee</span>
                    <span class="rc-fee-val">₹ @Money(Model.Summary.ConsultationFee)</span>
                </div>

                @if (showRegFee)
                {
                    <div class="rc-fee-row">
                        <span>Registration fee</span>
                        <span class="rc-fee-val">₹ @Money(Model.Summary.RegistrationFee)</span>
                    </div>
                }

                <div class="rc-fee-total">
                    <span>Total payable</span>
                    <span class="rc-fee-val">₹ @Money(total)</span>
                </div>

                @* Primary action lives here so it is always in view next to the total (card is sticky on desktop) *@
                <button type="button" class="rc-btn-confirm rc-btn-block rc-cta-desktop" data-confirm>Confirm &amp; Proceed to Payment →</button>
                <a asp-page="/PatientDetails/PatientDetails" class="rc-btn-back rc-btn-block rc-cta-desktop">← Back to Patient Details</a>
            </section>

        </aside>
    </div>

    @* Tablet / phone: Back sits at the end of the content ... *@
    <div class="rc-footer">
        <a asp-page="/PatientDetails/PatientDetails" class="rc-btn-back">← Back to Patient Details</a>
    </div>

    @* ... and the Confirm button stays fixed at the bottom of the screen, together with the total *@
    <div class="rc-mobilebar">
        <div class="rc-mobilebar-total">
            <span>Total payable</span>
            <strong>₹ @Money(total)</strong>
        </div>
        <button type="button" class="rc-btn-confirm" data-confirm>Confirm &amp; Proceed →</button>
    </div>

</div>

@* ── Payment modal (options come from PaymentSettings; payment itself is wired later via the "payment:selected" event) ── *@
<div class="rc-modal-overlay" id="paymentModal" role="dialog" aria-modal="true" aria-labelledby="paymentModalTitle" hidden>
    <div class="rc-modal">
        <div class="rc-modal-header">
            <div>
                <div class="rc-modal-title" id="paymentModalTitle">Choose payment option</div>
                <div class="rc-modal-sub">Total payable ₹ @Money(total)</div>
            </div>
            <button type="button" class="rc-modal-close" id="paymentModalClose" aria-label="Close">✕</button>
        </div>
        <div class="rc-modal-body">
            @if (Model.Summary.EnablePayOnArrival)
            {
                <button type="button" class="rc-payment-option" data-payment="arrival">
                    <span class="rc-pay-icon" aria-hidden="true">🏥</span>
                    <span class="rc-pay-info">
                        <span class="rc-pay-title">Pay on arrival</span>
                        <span class="rc-pay-sub">Pay at the hospital counter</span>
                    </span>
                    <span class="rc-pay-arrow" aria-hidden="true">→</span>
                </button>
            }

            @if (Model.Summary.EnablePayNow)
            {
                <button type="button" class="rc-payment-option" data-payment="now">
                    <span class="rc-pay-icon" aria-hidden="true">💳</span>
                    <span class="rc-pay-info">
                        <span class="rc-pay-title">Pay now</span>
                        <span class="rc-pay-sub">Pay online securely</span>
                    </span>
                    <span class="rc-pay-arrow" aria-hidden="true">→</span>
                </button>
            }

            @if (!Model.Summary.EnablePayNow && !Model.Summary.EnablePayOnArrival)
            {
                <div class="rc-payment-empty">No payment options available. Please contact support.</div>
            }
        </div>
    </div>
</div>

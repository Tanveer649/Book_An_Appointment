@page
@model Book_An_Appointment1.Pages.ReviewAndConfimation.ReviewAndConfirmationModel
@functions {
    // Whole rupees show without decimals (₹ 900); a fractional fee shows exactly (₹ 1.50) so the summary never misstates what is charged.
    static string Money(decimal v) => v == decimal.Truncate(v) ? v.ToString("N0") : v.ToString("N2");
}
@{
    ViewData["Title"] = L["Review.PageTitle"];

    var isNewPatient = Model.Summary.PatientType != "registered";
    var editIcon = "<svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 20h9\" /><path d=\"M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z\" /></svg>";
    var showRegFee = isNewPatient && Model.Summary.RegistrationFee > 0;
    var total = Model.Summary.ConsultationFee + (isNewPatient ? Model.Summary.RegistrationFee : 0);
}

@section Styles {
    <link rel="stylesheet" href="~/css/review-confirm.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/pages/review-confirm.js" asp-append-version="true"></script>
}

<div class="rc-page">

    @* ── Progress Bar ── *@
    <div class="progress-bar">
        <div class="step-item"><div class="step-circle done">✓</div><span class="step-label done">@L["Steps.SelectSlot"]</span></div>
        <div class="step-connector done"></div>
        <div class="step-item"><div class="step-circle done">✓</div><span class="step-label done">@L["Steps.PatientDetails"]</span></div>
        <div class="step-connector done"></div>
        <div class="step-item"><div class="step-circle active">3</div><span class="step-label active">@L["Steps.ReviewConfirm"]</span></div>
        <div class="step-connector"></div>
        <div class="step-item"><div class="step-circle pending">4</div><span class="step-label">@L["Steps.Payment"]</span></div>
    </div>

    <div class="rc-header">
        <h1 class="rc-title">@L["Review.Title"]</h1>
        <p class="rc-sub">@L["Review.Subtitle"]</p>
    </div>

    <div class="rc-layout">

        <div class="rc-main">

            <div class="rc-info-box">
                <span class="rc-info-icon" aria-hidden="true">ℹ</span>
                <div>
                    <div class="rc-info-title">@L["Review.CheckCarefully"]</div>
                    <div class="rc-info-sub">@L["Review.CheckCarefullySub"]</div>
                </div>
            </div>

            @* ── Appointment details ── *@
            <section class="rc-card">
                <div class="rc-card-header">
                    <h2 class="rc-card-title"><span class="rc-icon" aria-hidden="true">📋</span>@L["Review.AppointmentDetails"]</h2>
                    <a asp-page="/Appointment/Appointment" class="rc-edit-btn">@Html.Raw(editIcon) @L["Review.Edit"]</a>
                </div>

                <div class="rc-detail-row">
                    <span class="rc-detail-icon" aria-hidden="true">🏥</span>
                    <span class="rc-detail-label">@L["Review.Hospital"]</span>
                    <span class="rc-detail-value">@Model.Summary.HospitalName</span>
                </div>
                <div class="rc-detail-row">
                    <span class="rc-detail-icon" aria-hidden="true">🩺</span>
                    <span class="rc-detail-label">@L["Review.Specialty"]</span>
                    <span class="rc-detail-value">@Model.Summary.Specialisation</span>
                </div>
                <div class="rc-detail-row">
                    <span class="rc-detail-icon" aria-hidden="true">👨‍⚕️</span>
                    <span class="rc-detail-label">@L["Review.Doctor"]</span>
                    <span class="rc-detail-value">@Model.Summary.DoctorName</span>
                </div>
                <div class="rc-detail-row">
                    <span class="rc-detail-icon" aria-hidden="true">📅</span>
                    <span class="rc-detail-label">@L["Review.AppointmentDate"]</span>
                    <span class="rc-detail-value">
                        @(DateTime.TryParse(Model.Summary.SlotDate, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var sd) ? sd.ToString("ddd, dd MMM yyyy") : Model.Summary.SlotDate)
                    </span>
                </div>
                <div class="rc-detail-row">
                    <span class="rc-detail-icon" aria-hidden="true">🕐</span>
                    <span class="rc-detail-label">@L["Review.AppointmentTime"]</span>
                    <span class="rc-detail-value">
                        @(DateTime.TryParse(Model.Summary.SlotTime, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var st) ? st.ToString("hh:mm tt") : Model.Summary.SlotTime)
                    </span>
                </div>
                <div class="rc-detail-row">
                    <span class="rc-detail-icon" aria-hidden="true">💰</span>
                    <span class="rc-detail-label">@L["Review.ConsultationFee"]</span>
                    <span class="rc-detail-value rc-fee">₹ @Money(Model.Summary.ConsultationFee)</span>
                </div>
            </section>

            @* ── Patient information ── *@
            <section class="rc-card">
                <div class="rc-card-header">
                    <h2 class="rc-card-title"><span class="rc-icon" aria-hidden="true">👤</span>@L["Review.PatientInformation"]</h2>
                    <div class="rc-card-header-right">
                        <span class="rc-verified-badge">@L["Common.Verified"]</span>
                        <a asp-page="/PatientDetails/PatientDetails" class="rc-edit-btn">@Html.Raw(editIcon) @L["Review.Edit"]</a>
                    </div>
                </div>

                <div class="rc-patient-grid">
                    <div class="rc-patient-item">
                        <span class="rc-patient-label">@L["Review.PatientType"]</span>
                        <span class="rc-patient-value">@(isNewPatient ? L["Common.NewPatient"] : L["Common.RegisteredPatient"])</span>
                    </div>
                    <div class="rc-patient-item">
                        <span class="rc-patient-label">@L["Review.FullName"]</span>
                        <span class="rc-patient-value">@Model.Summary.FullName</span>
                    </div>
                    <div class="rc-patient-item">
                        <span class="rc-patient-label">@L["Review.Gender"]</span>
                        <span class="rc-patient-value">@L.TextOr("Gender." + Model.Summary.Gender, Model.Summary.Gender)</span>
                    </div>
                    <div class="rc-patient-item">
                        <span class="rc-patient-label">@L["Review.DateOfBirth"]</span>
                        <span class="rc-patient-value">@Model.Summary.FormattedDOB</span>
                    </div>
                    <div class="rc-patient-item">
                        <span class="rc-patient-label">@L["Review.MobileNumber"]</span>
                        <span class="rc-patient-value">@Model.Summary.CountryCode @Model.Summary.Mobile</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Summary.Email))
                    {
                        <div class="rc-patient-item">
                            <span class="rc-patient-label">@L["Review.Email"]</span>
                            <span class="rc-patient-value">@Model.Summary.Email</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Summary.BloodGroup))
                    {
                        <div class="rc-patient-item">
                            <span class="rc-patient-label">@L["Review.BloodGroup"]</span>
                            <span class="rc-patient-value">@Model.Summary.BloodGroup</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Summary.Address))
                    {
                        <div class="rc-patient-item rc-full-width">
                            <span class="rc-patient-label">@L["Review.Address"]</span>
                            <span class="rc-patient-value">@Model.Summary.Address</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Summary.RegistrationNo))
                    {
                        <div class="rc-patient-item rc-full-width">
                            <span class="rc-patient-label">@L["Review.Uhid"]</span>
                            <span class="rc-patient-value">@Model.Summary.RegistrationNo</span>
                        </div>
                    }
                </div>
            </section>

            @* ── Appointment notes ── *@
            <section class="rc-card">
                <div class="rc-card-header">
                    <h2 class="rc-card-title"><span class="rc-icon" aria-hidden="true">📝</span>@L["Review.AppointmentNotes"]</h2>
                    <a asp-page="/PatientDetails/PatientDetails" class="rc-edit-btn">@Html.Raw(editIcon) @L["Review.Edit"]</a>
                </div>
                <div class="rc-notes-label">@L["Review.SymptomsReason"]</div>
                @if (!string.IsNullOrWhiteSpace(Model.Summary.AppointmentNotes))
                {
                    <div class="rc-notes-text">@Model.Summary.AppointmentNotes</div>
                }
                else
                {
                    <div class="rc-notes-empty">@L["Review.NoNotes"]</div>
                }
            </section>

        </div>

        <aside class="rc-aside">

            @* ── Payment summary ── *@
            <section class="rc-fee-card">
                <h2 class="rc-fee-title"><span aria-hidden="true">💳</span> @L["Review.PaymentSummary"]</h2>

                <div class="rc-fee-row">
                    <span>@L["Review.ConsultationFee"]</span>
                    <span class="rc-fee-val">₹ @Money(Model.Summary.ConsultationFee)</span>
                </div>

                @if (showRegFee)
                {
                    <div class="rc-fee-row">
                        <span>@L["Review.RegistrationFee"]</span>
                        <span class="rc-fee-val">₹ @Money(Model.Summary.RegistrationFee)</span>
                    </div>
                }

                <div class="rc-fee-total">
                    <span>@L["Review.TotalPayable"]</span>
                    <span class="rc-fee-val">₹ @Money(total)</span>
                </div>

                @* Primary action lives here so it is always in view next to the total (card is sticky on desktop) *@
                <button type="button" class="rc-btn-confirm rc-btn-block rc-cta-desktop" data-confirm>@L["Review.ConfirmProceedPayment"]</button>
                <a asp-page="/PatientDetails/PatientDetails" class="rc-btn-back rc-btn-block rc-cta-desktop">@L["Review.BackToPatientDetails"]</a>
            </section>

        </aside>
    </div>

    @* Tablet / phone: Back sits at the end of the content ... *@
    <div class="rc-footer">
        <a asp-page="/PatientDetails/PatientDetails" class="rc-btn-back">@L["Review.BackToPatientDetails"]</a>
    </div>

    @* ... and the Confirm button stays fixed at the bottom of the screen, together with the total *@
    <div class="rc-mobilebar">
        <div class="rc-mobilebar-total">
            <span>@L["Review.TotalPayable"]</span>
            <strong>₹ @Money(total)</strong>
        </div>
        <button type="button" class="rc-btn-confirm" data-confirm>@L["Review.ConfirmProceed"]</button>
    </div>

</div>

@* Token for the CreateAppointment AJAX call (review-confirm.js) *@
@Html.AntiForgeryToken()

@* ── Payment modal (options come from PaymentSettings; choosing one calls ?handler=CreateAppointment) ── *@
<div class="rc-modal-overlay" id="paymentModal" role="dialog" aria-modal="true" aria-labelledby="paymentModalTitle"
     data-slot-start="@Model.Summary.SlotTime" hidden>
    <div class="rc-modal">
        <div class="rc-modal-header">
            <div>
                <div class="rc-modal-title" id="paymentModalTitle">@L["Review.ChoosePayment"]</div>
                <div class="rc-modal-sub">@L["Review.TotalPayable"] ₹ @Money(total)</div>
            </div>
            <button type="button" class="rc-modal-close" id="paymentModalClose" aria-label="@L["Common.Close"]">✕</button>
        </div>
        <div class="rc-modal-body">
            <div class="rc-pay-error" id="paymentError" role="alert" hidden></div>
            <div class="rc-pay-status" id="paymentStatus" role="status" hidden>
                <span class="rc-spinner" aria-hidden="true"></span> @L["Review.Booking"]
            </div>

            @if (Model.Summary.EnablePayOnArrival)
            {
                <button type="button" class="rc-payment-option" data-payment="arrival">
                    <span class="rc-pay-icon" aria-hidden="true">🏥</span>
                    <span class="rc-pay-info">
                        <span class="rc-pay-title">@L["Review.PayOnArrival"]</span>
                        <span class="rc-pay-sub">@L["Review.PayOnArrivalSub"]</span>
                    </span>
                    <span class="rc-pay-arrow" aria-hidden="true">→</span>
                </button>
            }

            @if (Model.Summary.EnablePayNow)
            {
                <button type="button" class="rc-payment-option" data-payment="now">
                    <span class="rc-pay-icon" aria-hidden="true">💳</span>
                    <span class="rc-pay-info">
                        <span class="rc-pay-title">@L["Review.PayNow"]</span>
                        <span class="rc-pay-sub">@L["Review.PayNowSub"]</span>
                    </span>
                    <span class="rc-pay-arrow" aria-hidden="true">→</span>
                </button>
            }

            @if (!Model.Summary.EnablePayNow && !Model.Summary.EnablePayOnArrival)
            {
                <div class="rc-payment-empty">@L["Review.NoPaymentOptions"]</div>
            }
        </div>
    </div>
</div>

@* ── Booked modal (Pay on arrival) — values filled by review-confirm.js from the CreateAppointment response ── *@
<div class="rc-modal-overlay" id="bookedModal" role="dialog" aria-modal="true" aria-labelledby="bookedModalTitle" hidden>
    <div class="rc-modal rc-booked">

        @* Header — success + status badge *@
        <div class="rc-booked-head">
            <div class="rc-booked-icon" aria-hidden="true">✓</div>
            <div class="rc-booked-heading">
                <div class="rc-modal-title" id="bookedModalTitle">@L["Review.Booked"]</div>
                <div class="rc-modal-sub">@L["Review.BookedSub"]</div>
            </div>
            <span class="rc-booked-status" data-booked-row><span data-booked="status"></span></span>
        </div>

        @* Hero — the three things the patient must remember *@
        <div class="rc-booked-hero">
            <div class="rc-hero-tile" data-booked-row>
                <span class="rc-hero-label">@L["Review.AppointmentId"]</span>
                <span class="rc-hero-value rc-hero-id" data-booked="appointmentId"></span>
            </div>
            <div class="rc-hero-tile" data-booked-row>
                <span class="rc-hero-label">@L["Review.Date"]</span>
                <span class="rc-hero-value" data-booked="appointmentDate"></span>
                <span class="rc-hero-sub" data-booked="appointmentDay"></span>
            </div>
            <div class="rc-hero-tile" data-booked-row>
                <span class="rc-hero-label">@L["Review.Time"]</span>
                <span class="rc-hero-value" data-booked="appointmentTime"></span>
            </div>
        </div>

        @* Details — compact grid instead of a long vertical list *@
        <dl class="rc-booked-grid">
            <div class="rc-booked-item" data-booked-row><dt>@L["Review.Patient"]</dt><dd data-booked="patientName"></dd></div>
            <div class="rc-booked-item" data-booked-row><dt>@L["Review.Uhid"]</dt><dd data-booked="registrationNo"></dd></div>
            <div class="rc-booked-item" data-booked-row><dt>@L["Review.Mobile"]</dt><dd data-booked="mobile"></dd></div>
            <div class="rc-booked-item" data-booked-row><dt>@L["Review.Doctor"]</dt><dd data-booked="doctorName"></dd></div>
            <div class="rc-booked-item" data-booked-row><dt>@L["Review.Specialty"]</dt><dd data-booked="specialisation"></dd></div>
            <div class="rc-booked-item" data-booked-row><dt>@L["Review.Hospital"]</dt><dd data-booked="hospitalName"></dd></div>
            <div class="rc-booked-item" data-booked-row><dt>@L["Review.VisitType"]</dt><dd data-booked="visitType"></dd></div>
            <div class="rc-booked-item" data-booked-row><dt>@L["Review.Payment"]</dt><dd data-booked="paymentMode"></dd></div>
            <div class="rc-booked-item" data-booked-row><dt>@L["Review.AmountPayable"]</dt><dd class="rc-booked-amount" data-booked="amountPayable"></dd></div>
        </dl>

        @* Footer — note + action side by side *@
        <div class="rc-booked-foot">
            <p class="rc-booked-note"><span aria-hidden="true">ℹ</span> @L["Review.ArrivalNote"]</p>
            <a asp-page="/Appointment/Appointment" class="rc-btn-confirm" id="bookedDone">@L["Review.BookAnother"]</a>
        </div>
    </div>
</div>

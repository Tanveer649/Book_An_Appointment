<!DOCTYPE html>
@inject Book_An_Appointment1.Helpers.ThemeProvider Theme
@{
    var currentLanguage = Languages.Current;
    var currentCulture = Languages.CultureOf(currentLanguage);
    var scriptFont = currentLanguage.Font?.Trim();
    var themeUrl = Theme.ThemeUrl;   // wwwroot/themes/{ThemeSettings:Theme}.css
}
<html lang="@currentLanguage.Code" dir="@(currentCulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />   @* matches the white header for every hospital theme *@

    <title>@ViewData["Title"] - @L["Layout.TitleSuffix"]</title>

    @* CDN files pinned to exact versions + integrity hash: a changed/tampered file is refused by the browser *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet"
          integrity="sha384-OXVF05DQEe311p6ohU11NwlnX08FzMCsyoXzGOaL+83dKAb3qS17yZJxESl8YrJQ" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css"
          integrity="sha384-RkASv+6KfBMW9eknReJIJ6b3UnjKOKC5bOUaNgIY778NFbQ8MtWq9Lr/khUgqtTt" crossorigin="anonymous" />

    @* Colours: shared variables, then the hospital theme (appsettings ThemeSettings:Theme), then page styles *@
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    @if (themeUrl != null)
    {
        <link rel="stylesheet" href="@themeUrl" asp-append-version="true" />
    }

    @await RenderSectionAsync("Styles", required: false)

    @* Non-Latin script (LanguageSettings Font): load the font and put it in every font stack.
       letter-spacing is reset because it breaks joined scripts like Devanagari / Bengali. *@
    @if (!string.IsNullOrWhiteSpace(scriptFont))
    {
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=@(scriptFont.Replace(' ', '+')):wght@@400;500;600;700&display=swap" />
        <style>
            html:root {
                --font-body: 'Inter', '@scriptFont', 'Segoe UI', sans-serif;
                --font-display: 'Fraunces', '@scriptFont', Georgia, serif;
                --bs-body-font-family: var(--font-body);
            }

            html:root body, html:root button, html:root input, html:root select, html:root textarea {
                font-family: var(--font-body);
            }

            html:root * {
                letter-spacing: normal !important;
            }
        </style>
    }
</head>
<body>
    @* Header *@
    @await Html.PartialAsync("Header")

   <main class="@(ViewData["FullWidth"] as bool? == true ? "container-fluid" : "container")">
        @RenderBody()
    </main>


    @* Footer *@
    @await Html.PartialAsync("~/Pages/Footer.cshtml")

   <script src="https://code.jquery.com/jquery-3.7.1.min.js"
            integrity="sha384-1H217gwSVyLSIfaLxHbE7dRb3v4mYCKbpQvzx0cegeju1MVsGrX5xXxAvs/HgeFs" crossorigin="anonymous"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"
            integrity="sha384-d3UHjPdzJkZuk5H3qKYMLRyWLAQBJbby2yr2Q58hXXtAGF8RSNO9jpLDlKKPv5v3" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"
            integrity="sha384-5JqMv4L/Xa0hfvtF06qboNdhvuYXUku9ZrhZh3bSk8VXF0A/RuSLHpLsSV9Zqhl6" crossorigin="anonymous"></script>

    @* Translations for page scripts — use t('Section.Key') (wwwroot/js/i18n.js) *@
    <script>
        window.APP_LANG = '@currentLanguage.Code';
        window.I18N = @Html.Raw(Json.Serialize(L.ForScript("Js", "Validation", "Errors", "Gender")));
    </script>
    <script src="~/js/i18n.js" asp-append-version="true"></script>
    <script>
        // Browser Back / Forward cache must never show an older booking step — reload asks the server for the current one
        window.addEventListener('pageshow', function (e) { if (e.persisted) location.reload(); });
    </script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

@page "/book-appointment"
@model Book_An_Appointment1.Pages.Appointment.AppointmentModel
@{
    ViewData["Title"] = L["Appointment.PageTitle"];

    var doc = Model.Wizard.SelectedDoctor;
    bool hasDoctor = doc != null;

    // Initial doctor payload (page load / back button / validation re-render).
    // The same JS template renders it, so the card looks identical to the AJAX path.
    object? initialDoctor = null;
    if (doc != null)
    {
        var hospital = doc.ConsultingHospitals?.FirstOrDefault();
        var feeRaw = Model.Wizard.ConsultationFeeList?.FirstOrDefault()?.Price
                    ?? Model.Wizard.ConsultationFeeList?.FirstOrDefault()?.NetAmount
                    ?? "0";
        var fee = global::Book_An_Appointment1.Pages.Appointment.AppointmentModel.FormatFee(feeRaw);

        initialDoctor = new
        {
            name = doc.Name,
            specialisation = doc.SpecialisationName,
            experience = doc.Experience,
            imageUrl = doc.ImageUrl,
            icon = doc.Icon,
            education = doc.Education,
            rating = doc.Rating,
            review = doc.Review,
            treatment = doc.Treatment,
            timing = doc.Timing,
            isTeleconsult = doc.IsTeleconsult,
            fee = fee,
            hospitalName = hospital?.FacilityName,
            hospitalCity = hospital?.CityName,
            hospitalLocationId = doc.HospitalLocationId,
            slots = Model.Wizard.Slots.Select(s => new { startTime = s.StartTime, endTime = s.EndTime })
        };
    }
}
@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/css/appointment.css" asp-append-version="true" />
}
<form method="post" id="appointmentForm">
    @Html.AntiForgeryToken()

    <input type="hidden" name="selectedSlotStart" id="hdnSelectedSlotStart" value="" />
    <input type="hidden" name="selectedSlotEnd" id="hdnSelectedSlotEnd" value="" />
    <input type="hidden" name="facilityId" id="hdnFacilityId" value="@Model.FacilityId" />
    <input type="hidden" name="specialityId" id="hdnSpecialityId" value="@(Model.SpecialityId ?? 0)" />
    <input type="hidden" name="doctorId" id="hdnDoctorId" value="@(Model.DoctorId ?? 0)" />
    <input type="hidden" name="patientType" id="hdnPatientType" value="" />

    <div class="container mt-5">

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger mb-4"><strong>@L["Common.Error"]</strong> @Model.ErrorMessage</div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger mb-4">
                <ul class="mb-0">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <div id="clientValidationError"></div>

        <div class="progress-bar">
            <div class="step-item"><div class="step-circle active">1</div><span class="step-label active">@L["Steps.AppointmentDetails"]</span></div>
            <div class="step-connector"></div>
            <div class="step-item"><div class="step-circle pending">2</div><span class="step-label">@L["Steps.PatientDetails"]</span></div>
            <div class="step-connector"></div>
            <div class="step-item"><div class="step-circle pending">3</div><span class="step-label">@L["Steps.ReviewConfirm"]</span></div>
            <div class="step-connector"></div>
            <div class="step-item"><div class="step-circle pending">4</div><span class="step-label">@L["Steps.Payment"]</span></div>
        </div>

        <div class="selector-bar">
            <div class="dropdown-group">
                <label class="form-label fw-bold" for="facilityDropdown">@L["Appointment.Facility"] <span class="text-danger">*</span></label>
                <select name="FacilityId" id="facilityDropdown" class="form-select select2">
                    <option value="">@L["Js.SelectFacility"]</option>
                    @foreach (var item in Model.Wizard.Facilities)
                    {
                        <option value="@item.FacilityId" selected="@(item.FacilityId == Model.FacilityId)">@(item.FacilityName ?? "N/A")</option>
                    }
                </select>
            </div>

            <div class="dropdown-group">
                <label class="form-label fw-bold" for="specialityDropdown">@L["Appointment.Speciality"] <span class="text-danger">*</span></label>
                <span class="dropdown-lock-wrap" id="specialityLockWrap" data-tooltip="@L["Js.SelectFacilityFirst"]">
                    <select name="SpecialityId" id="specialityDropdown" class="form-select select2" disabled>
                        <option value="">@L["Js.SearchSpeciality"]</option>
                        @foreach (var item in Model.Wizard.Specialities)
                        {
                            <option value="@item.Id" selected="@(item.Id == (Model.SpecialityId ?? 0).ToString())">@(item.SpecialisationName ?? "N/A")</option>
                        }
                    </select>
                </span>
            </div>

            <div class="dropdown-group">
                <label class="form-label fw-bold" for="doctorDropdown">@L["Appointment.Doctor"] <span class="text-danger">*</span></label>
                <span class="dropdown-lock-wrap" id="doctorLockWrap" data-tooltip="@L["Js.SelectFacilityFirst"]">
                    <select name="DoctorId" id="doctorDropdown" class="form-select select2" disabled>
                        <option value="">@L["Js.SearchDoctor"]</option>
                        @if (Model.Wizard.Doctors != null)
                        {
                            foreach (var item in Model.Wizard.Doctors)
                            {
                                <option value="@item.Id" selected="@(item.Id == (Model.DoctorId ?? 0).ToString())">@(item.Name ?? "N/A")</option>
                            }
                        }
                    </select>
                </span>
            </div>
        </div>

        @* Before a doctor is chosen *@
        <div id="welcomeStage" class="welcome-stage" style="@(hasDoctor ? "display:none" : "")">
            <div id="emptyState" class="empty-hint">
                <div>
                    <h2 class="welcome-title">@L["Appointment.WelcomeTitle"]</h2>
                    <p class="welcome-text">@L["Appointment.WelcomeText"]</p>
                </div>
                <ol class="welcome-steps" id="welcomeSteps">
                    <li class="current" data-step="facility"><span class="num">1</span>@L["Appointment.StepFacility"]</li>
                    <li data-step="speciality"><span class="num">2</span>@L["Appointment.StepSpeciality"]</li>
                    <li data-step="doctor"><span class="num">3</span>@L["Appointment.StepDoctor"]</li>
                    <li data-step="slot"><span class="num">4</span>@L["Appointment.StepSlot"]</li>
                </ol>
            </div>
            <div id="hospitalCarousel" class="carousel" style="display:none">
                <div class="carousel-track" id="carouselTrack"></div>
                <div class="carousel-dots" id="carouselDots"></div>
            </div>
        </div>

        @* After a doctor is chosen: card (left) + date/slots (right), both filled by appointment.js *@
        <div id="bookingStage" class="booking-stage" style="@(hasDoctor ? "" : "display:none")">
            <div id="doctorIdentityCard" class="doctor-card"></div>
            <div id="bookingPanel"></div>
        </div>

    </div>

    <div id="patientTypeDialog" class="app-dialog" role="dialog" aria-modal="true" aria-labelledby="patientTypeTitle" hidden>
        <div class="app-dialog-card wide">
            <button type="button" id="patientTypeClose" class="dialog-close" aria-label="@L["Common.Close"]">&times;</button>
            <h4 id="patientTypeTitle">@L["Appointment.VisitedBefore"]</h4>
            <p>@L["Appointment.ChooseHowToContinue"]</p>
            <div class="choice-grid">
                <button type="button" class="choice-card" data-type="new">
                    <span class="choice-icon" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M19 8v6M22 11h-6" /></svg>
                    </span>
                    <span class="choice-title">@L["Common.NewPatient"]</span>
                    <span class="choice-desc">@L["Appointment.NewPatientDesc"]</span>
                </button>
                <button type="button" class="choice-card" data-type="registered">
                    <span class="choice-icon" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="m16 11 2 2 4-4" /></svg>
                    </span>
                    <span class="choice-title">@L["Common.AlreadyRegistered"]</span>
                    <span class="choice-desc">@L["Appointment.RegisteredDesc"]</span>
                </button>
            </div>
        </div>
    </div>

    <div id="limitDialog" class="app-dialog" role="alertdialog" aria-modal="true" aria-labelledby="limitDialogTitle" hidden>
        <div class="app-dialog-card">
            <h4 id="limitDialogTitle">@L["Appointment.DateTooFar"]</h4>
            <p id="limitDialogText"></p>
            <button type="button" id="limitDialogClose" class="btn-continue">@L["Appointment.ChooseAnotherDate"]</button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        window.AppointmentConfig = {
            facilityId: @Html.Raw(Json.Serialize(Model.FacilityId.ToString())),
            specialityId: @Html.Raw(Json.Serialize((Model.SpecialityId ?? 0).ToString())),
            doctorId:     @(Model.DoctorId ?? 0),
            savedSlotDate: @Html.Raw(Json.Serialize(Model.SavedSlotDate ?? "")),
            savedSlotStart: @Html.Raw(Json.Serialize(Model.SavedSlotStart ?? "")),
            hospitalLocationId: @(doc?.HospitalLocationId ?? 0),
            maxAdvanceDays: @Model.Wizard.MaxAppointmentAllowedDays,
            initialDoctor: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(initialDoctor)),
            // Add these files under wwwroot/images (1600 x 1000 px, 16:10). Missing files are skipped automatically.
            hospitalImages: [
                { src: '/images/HospitalImages/img1.png', caption: '' },
                { src: '/images/HospitalImages/img2.png', caption: '' },
                { src: '/images/HospitalImages/img3.png', caption: '' },
                { src: '/images/HospitalImages/img4.png', caption: '' },
                { src: '/images/HospitalImages/img5.png', caption: '' }
            ]
        };
    </script>
    <script src="~/js/pages/appointment.js" asp-append-version="true"></script>
}

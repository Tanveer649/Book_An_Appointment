@page "/Appointment"
@model Book_An_Appointment1.Pages.Appointment.AppointmentModel
@{
    ViewData["Title"] = "Book Appointment";

    var doc = Model.Wizard.SelectedDoctor;
    bool hasDoctor = doc != null;

    // Initial doctor payload (page load / back button / validation re-render).
    // The same JS template renders it, so the card looks identical to the AJAX path.
    object initialDoctor = null;
    if (hasDoctor)
    {
        var hospital = doc.ConsultingHospitals?.FirstOrDefault();
        var feeRaw = Model.Wizard.ConsultationFeeList?.FirstOrDefault()?.Price
                    ?? Model.Wizard.ConsultationFeeList?.FirstOrDefault()?.NetAmount
                    ?? "0";
        var fee = global::Book_An_Appointment1.Pages.Appointment.AppointmentModel.FormatFee(feeRaw);

        initialDoctor = new
        {
            name = doc.Name,
            specialisation = doc.SpecialisationName,
            experience = doc.Experience,
            imageUrl = doc.ImageUrl,
            icon = doc.Icon,
            education = doc.Education,
            rating = doc.Rating,
            review = doc.Review,
            treatment = doc.Treatment,
            timing = doc.Timing,
            isTeleconsult = doc.IsTeleconsult,
            fee = fee,
            hospitalName = hospital?.FacilityName,
            hospitalCity = hospital?.CityName,
            hospitalLocationId = doc.HospitalLocationId,
            slots = Model.Wizard.Slots.Select(s => new { startTime = s.StartTime, endTime = s.EndTime })
        };
    }
}
@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/css/appointment.css" asp-append-version="true" />
}
<form method="post" id="appointmentForm">
    @Html.AntiForgeryToken()

    <input type="hidden" name="selectedSlotStart" id="hdnSelectedSlotStart" value="" />
    <input type="hidden" name="selectedSlotEnd" id="hdnSelectedSlotEnd" value="" />
    <input type="hidden" name="facilityId" id="hdnFacilityId" value="@Model.FacilityId" />
    <input type="hidden" name="specialityId" id="hdnSpecialityId" value="@(Model.SpecialityId ?? 0)" />
    <input type="hidden" name="doctorId" id="hdnDoctorId" value="@(Model.DoctorId ?? 0)" />
    <input type="hidden" name="patientType" id="hdnPatientType" value="" />

    <div class="container mt-5">

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger mb-4"><strong>Error:</strong> @Model.ErrorMessage</div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger mb-4">
                <ul class="mb-0">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <div id="clientValidationError"></div>

        <div class="progress-bar">
            <div class="step-item"><div class="step-circle active">1</div><span class="step-label active">Appointment details</span></div>
            <div class="step-connector"></div>
            <div class="step-item"><div class="step-circle pending">2</div><span class="step-label">Patient details</span></div>
            <div class="step-connector"></div>
            <div class="step-item"><div class="step-circle pending">3</div><span class="step-label">Review &amp; confirm</span></div>
            <div class="step-connector"></div>
            <div class="step-item"><div class="step-circle pending">4</div><span class="step-label">Payment</span></div>
        </div>

        <div class="selector-bar">
            <div class="dropdown-group">
                <label class="form-label fw-bold" for="facilityDropdown">Facility <span class="text-danger">*</span></label>
                <select name="FacilityId" id="facilityDropdown" class="form-select select2">
                    <option value="">Select Facility</option>
                    @foreach (var item in Model.Wizard.Facilities)
                    {
                        <option value="@item.FacilityId" selected="@(item.FacilityId == Model.FacilityId)">@(item.FacilityName ?? "N/A")</option>
                    }
                </select>
            </div>

            <div class="dropdown-group">
                <label class="form-label fw-bold" for="specialityDropdown">Speciality <span class="text-danger">*</span></label>
                <span class="dropdown-lock-wrap" id="specialityLockWrap" data-tooltip="Please select a facility first">
                    <select name="SpecialityId" id="specialityDropdown" class="form-select select2" disabled>
                        <option value="">Search Speciality</option>
                        @foreach (var item in Model.Wizard.Specialities)
                        {
                            <option value="@item.Id" selected="@(item.Id == (Model.SpecialityId ?? 0).ToString())">@(item.SpecialisationName ?? "N/A")</option>
                        }
                    </select>
                </span>
            </div>

            <div class="dropdown-group">
                <label class="form-label fw-bold" for="doctorDropdown">Doctor <span class="text-danger">*</span></label>
                <span class="dropdown-lock-wrap" id="doctorLockWrap" data-tooltip="Please select a facility first">
                    <select name="DoctorId" id="doctorDropdown" class="form-select select2" disabled>
                        <option value="">Search Doctor</option>
                        @if (Model.Wizard.Doctors != null)
                        {
                            foreach (var item in Model.Wizard.Doctors)
                            {
                                <option value="@item.Id" selected="@(item.Id == (Model.DoctorId ?? 0).ToString())">@(item.Name ?? "N/A")</option>
                            }
                        }
                    </select>
                </span>
            </div>
        </div>

        @* Before a doctor is chosen *@
        <div id="welcomeStage" class="welcome-stage" style="@(hasDoctor ? "display:none" : "")">
            <div id="emptyState" class="empty-hint">
                <div>
                    <h2 class="welcome-title">Find your doctor and book a slot</h2>
                    <p class="welcome-text">Choose where you want to be seen, then pick a speciality and a doctor to view their profile and live availability.</p>
                </div>
                <ol class="welcome-steps" id="welcomeSteps">
                    <li class="current" data-step="facility"><span class="num">1</span>Select a facility</li>
                    <li data-step="speciality"><span class="num">2</span>Select a speciality</li>
                    <li data-step="doctor"><span class="num">3</span>Select a doctor</li>
                    <li data-step="slot"><span class="num">4</span>Pick a date and time</li>
                </ol>
            </div>
            <div id="hospitalCarousel" class="carousel" style="display:none">
                <div class="carousel-track" id="carouselTrack"></div>
                <div class="carousel-dots" id="carouselDots"></div>
            </div>
        </div>

        @* After a doctor is chosen: card (left) + date/slots (right), both filled by appointment.js *@
        <div id="bookingStage" class="booking-stage" style="@(hasDoctor ? "" : "display:none")">
            <div id="doctorIdentityCard" class="doctor-card"></div>
            <div id="bookingPanel"></div>
        </div>

    </div>

    <div id="patientTypeDialog" class="app-dialog" role="dialog" aria-modal="true" aria-labelledby="patientTypeTitle" hidden>
        <div class="app-dialog-card wide">
            <button type="button" id="patientTypeClose" class="dialog-close" aria-label="Close">&times;</button>
            <h4 id="patientTypeTitle">Have you visited us before?</h4>
            <p>Choose how you would like to continue with your booking.</p>
            <div class="choice-grid">
                <button type="button" class="choice-card" data-type="new">
                    <span class="choice-icon" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M19 8v6M22 11h-6" /></svg>
                    </span>
                    <span class="choice-title">New patient</span>
                    <span class="choice-desc">This is my first visit</span>
                </button>
                <button type="button" class="choice-card" data-type="registered">
                    <span class="choice-icon" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="m16 11 2 2 4-4" /></svg>
                    </span>
                    <span class="choice-title">Already registered</span>
                    <span class="choice-desc">I have visited this hospital before</span>
                </button>
            </div>
        </div>
    </div>

    <div id="limitDialog" class="app-dialog" role="alertdialog" aria-modal="true" aria-labelledby="limitDialogTitle" hidden>
        <div class="app-dialog-card">
            <h4 id="limitDialogTitle">That date is too far ahead</h4>
            <p id="limitDialogText"></p>
            <button type="button" id="limitDialogClose" class="btn-continue">Choose another date</button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        window.AppointmentConfig = {
            facilityId: '@Model.FacilityId',
            specialityId: '@(Model.SpecialityId ?? 0)',
            doctorId:     @(Model.DoctorId ?? 0),
            savedSlotDate: '@(Model.SavedSlotDate ?? "")',
            savedSlotStart: '@(Model.SavedSlotStart ?? "")',
            hospitalLocationId: @(doc?.HospitalLocationId ?? 0),
            maxAdvanceDays: 90,
            initialDoctor: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(initialDoctor)),
            // Add these files under wwwroot/images (1600 x 1000 px, 16:10). Missing files are skipped automatically.
            hospitalImages: [
                { src: '/images/HospitalImages/img1.png', caption: '' },
                { src: '/images/HospitalImages/img2.png', caption: '' },
                { src: '/images/HospitalImages/img3.png', caption: '' },
                { src: '/images/HospitalImages/img4.png', caption: '' },
                { src: '/images/HospitalImages/img5.png', caption: '' }
            ]
        };
    </script>
    <script src="~/js/pages/appointment.js" asp-append-version="true"></script>
}




















@* @page "/Appointment"
@model Book_An_Appointment1.Pages.Appointment.AppointmentModel
@{
    ViewData["Title"] = "Book Appointment";
}
@section Styles {
    <link rel="stylesheet" href="~/css/appointment.css" asp-append-version="true" />
}
<form method="post" id="appointmentForm">
    @Html.AntiForgeryToken()

    <input type="hidden" name="selectedSlotStart" id="hdnSelectedSlotStart" value="" />
    <input type="hidden" name="selectedSlotEnd" id="hdnSelectedSlotEnd" value="" />
    <input type="hidden" name="facilityId" id="hdnFacilityId" value="@Model.FacilityId" />
    <input type="hidden" name="specialityId" id="hdnSpecialityId" value="@(Model.SpecialityId ?? 0)" />
    <input type="hidden" name="doctorId" id="hdnDoctorId" value="@(Model.DoctorId ?? 0)" />

    <div class="container mt-5">

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger mb-4">
                <strong>Error:</strong> @Model.ErrorMessage
            </div>
        }

        
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger mb-4">
                <ul class="mb-0">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        
        <div id="clientValidationError"></div>

       
        <div class="progress-bar">
            <div class="step-item">
                <div class="step-circle active">1</div>
                <span class="step-label active">Appointment details</span>
            </div>
            <div class="step-connector"></div>
            <div class="step-item">
                <div class="step-circle pending">2</div>
                <span class="step-label">Patient details</span>
            </div>
            <div class="step-connector"></div>
            <div class="step-item">
                <div class="step-circle pending">3</div>
                <span class="step-label">Review &amp; confirm</span>
            </div>
            <div class="step-connector"></div>
            <div class="step-item">
                <div class="step-circle pending">4</div>
                <span class="step-label">Payment</span>
            </div>
        </div>

       
        <div class="row g-4">

            <div class="col-md-4">
                <label class="form-label fw-bold">Facility <span class="text-danger">*</span></label>
                <select name="FacilityId" id="facilityDropdown" class="form-select select2">
                    <option value="">Select Facility</option>
                    @foreach (var item in Model.Wizard.Facilities)
                    {
                        <option value="@item.FacilityId" selected="@(item.FacilityId == Model.FacilityId)">
                            @(item.FacilityName ?? "N/A")
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold">Speciality <span class="text-danger">*</span></label>
                <span class="dropdown-lock-wrap" id="specialityLockWrap" data-tooltip="Please select a facility first">
                    <select name="SpecialityId" id="specialityDropdown" class="form-select select2" disabled>
                        <option value="">Search Speciality</option>
                        @foreach (var item in Model.Wizard.Specialities)
                        {
                            <option value="@item.Id" selected="@(item.Id == (Model.SpecialityId ?? 0).ToString())">
                                @(item.SpecialisationName ?? "N/A")
                            </option>
                        }
                    </select>
                </span>
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold">Doctor <span class="text-danger">*</span></label>
                <span class="dropdown-lock-wrap" id="doctorLockWrap" data-tooltip="Please select a facility first">
                    <select name="DoctorId" id="doctorDropdown" class="form-select select2" disabled>
                        <option value="">Search Doctor</option>
                        @if (Model.Wizard.Doctors != null)
                        {
                            foreach (var item in Model.Wizard.Doctors)
                            {
                                <option value="@item.Id" selected="@(item.Id == (Model.DoctorId ?? 0).ToString())">
                                    @(item.Name ?? "N/A")
                                </option>
                            }
                        }
                    </select>
                </span>
            </div>

        </div>

       
        <div id="doctorDetailsCard"
             class="card shadow-lg border-0 rounded-4 mt-5 p-4"
             style="@(Model.Wizard.SelectedDoctor != null ? "" : "display:none")">

            @if (Model.Wizard.SelectedDoctor != null)
            {
                var doc = Model.Wizard.SelectedDoctor;
                var hospital = doc.ConsultingHospitals?.FirstOrDefault();
                var feeRaw = Model.Wizard.ConsultationFeeList?.FirstOrDefault()?.Price
                            ?? Model.Wizard.ConsultationFeeList?.FirstOrDefault()?.NetAmount
                            ?? "0";

                var fee = decimal.TryParse(feeRaw, out var feeDecimal)
                            ? ((int)feeDecimal).ToString()
                            : feeRaw;

                var imageUrl = (doc.ImageUrl ?? "").Replace("http://", "https://");

                <div class="row">
                    <div class="col-md-3 text-center">
                        <img src="@imageUrl"
                             style="width:180px;height:180px;object-fit:cover;border-radius:50%;"
                             onerror="this.onerror=null; this.src='/Image/default-doctor.png';" />
                        <div class="mt-2">
                            <span class="badge bg-warning text-dark">⭐ @(doc.Rating ?? "N/A")</span>
                            <span class="text-muted ms-1" style="font-size:12px;">(@(doc.Review ?? "0") reviews)</span>
                        </div>
                        @if (doc.IsTeleconsult)
                        {
                            <div class="mt-2">
                                <span class="badge bg-success">Teleconsultation Available</span>
                            </div>
                        }
                    </div>
                    <div class="col-md-9">
                        <h3>@doc.Name</h3>
                        <p class="text-muted mb-3">@doc.SpecialisationName</p>
                        <div class="row g-2">
                            <div class="col-md-6"><strong>Experience:</strong> <span>@doc.Experience</span></div>
                            <div class="col-md-6"><strong>Consultation Fee:</strong> <span class="text-success fw-bold">₹ @fee</span></div>
                            <div class="col-md-6"><strong>Next Available:</strong> <span>@doc.Timing</span></div>
                            @if (!string.IsNullOrWhiteSpace(doc.Treatment))
                            {
                                <div class="col-md-12"><strong>Treatments:</strong> <span>@doc.Treatment</span></div>
                            }
                            @if (hospital != null)
                            {
                                <div class="col-md-12"><strong>Hospital:</strong> <span>@hospital.FacilityName, @hospital.CityName</span></div>
                            }
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="row g-4">
                    <div class="col-md-4">
                        <h5 class="mb-3">Select Date</h5>
                        <input type="text" id="slotCalendar" class="form-control" placeholder="Select date" readonly style="display:none;" />
                        <div id="calendarContainer"></div>
                    </div>
                    <div class="col-md-8">
                        <h5 class="mb-3">
                            Available Slots
                            <span id="slotDateLabel" class="text-muted fs-6 ms-2"></span>
                        </h5>
                        <div id="slotsContainer" class="d-flex flex-wrap gap-2">
                            @if (Model.Wizard.Slots.Any())
                            {
                                foreach (var slot in Model.Wizard.Slots)
                                {
                                    var parsed = DateTime.TryParse(slot.StartTime.Replace(" ", "T"), out var pdt);
                                    var timePart = parsed ? pdt.ToString("hh:mm tt") : slot.StartTime;
                                    var datePart = parsed ? pdt.ToString("dd MMM yyyy") : "";

                                    <button type="button" class="btn btn-outline-primary rounded-pill px-3 py-1 slot-btn"
                                            style="font-size:13px;"
                                            data-start="@slot.StartTime" data-end="@slot.EndTime">
                                        <div>@timePart</div>
                                        <div style="font-size:10px;color:#888;">@datePart</div>
                                    </button>
                                }
                            }
                            else
                            {
                                <div class="text-muted">No slots available for today.</div>
                            }
                        </div>
                    </div>
                </div>

                <input type="hidden" id="hdnHospitalLocationId" value="@doc.HospitalLocationId" />
                <input type="hidden" id="hdnDoctorIdForSlot" value="@Model.DoctorId" />
                <input type="hidden" id="hdnFacilityIdForSlot" value="@Model.FacilityId" />

                <div class="text-end mt-5">
                    <button type="button" id="continueBtn" class="btn btn-primary px-5 py-3 rounded-pill">
                        Continue →
                    </button>
                </div>
            }
        </div>

    </div>
</form>

@section Scripts {
    <script>
        window.AppointmentConfig = {
            facilityId:   '@Model.FacilityId',
            specialityId: '@(Model.SpecialityId ?? 0)',
            doctorId:     @(Model.DoctorId ?? 0),
            savedSlotDate:  '@(Model.SavedSlotDate ?? "")',
            savedSlotStart: '@(Model.SavedSlotStart ?? "")',
            hospitalLocationId: @(Model.Wizard.SelectedDoctor?.HospitalLocationId ?? 0)
        };
    </script>
    <script src="~/js/pages/appointment.js"></script>
}
 *@